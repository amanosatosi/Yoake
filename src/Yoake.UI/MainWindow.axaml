<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yoake.UI.ViewModels"
        xmlns:icons="using:Yoake.UI.Icons"
        xmlns:controls="using:Yoake.UI.Controls"
        xmlns:sub="using:Yoake.Core.Subtitles"
        x:Class="Yoake.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Yoake"
        Width="1440" Height="900"
        MinWidth="1040" MinHeight="680"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="36,66,*,4,300">
    <Border Grid.Row="0" Name="TitleTabStrip" Background="{DynamicResource TabStripBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <ScrollViewer Grid.Column="0" MaxWidth="980" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DocumentTabViewModel">
                <Border Margin="2,3,0,2" CornerRadius="4" Background="{DynamicResource TabBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="Auto,*,Auto" Width="230" Height="30">
                    <TextBlock Grid.Column="0" Margin="7,0,4,0" VerticalAlignment="Center" Text="●" FontSize="7" IsVisible="{Binding IsActive}" />
                    <Button Grid.Column="1" Padding="4,2" HorizontalContentAlignment="Left" Command="{Binding ActivateCommand}">
                      <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <Button Grid.Column="2" Width="28" Padding="6" Command="{Binding CloseCommand}" ToolTip.Tip="Close tab">
                      <PathIcon Width="11" Height="11" Data="{x:Static icons:IconGeometries.Close}" Foreground="{DynamicResource IconForegroundBrush}" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Border Grid.Column="1" WindowDecorationProperties.ElementRole="TitleBar" Background="Transparent" />
        <Button Grid.Column="2" Width="34" Height="30" Margin="3" Command="{Binding NewDocumentCommand}" ToolTip.Tip="New subtitle">
          <PathIcon Width="14" Height="14" Data="{x:Static icons:IconGeometries.New}" Foreground="{DynamicResource IconForegroundBrush}" />
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource CommandBarBrush}"><Grid RowDefinitions="28,*"><Menu>
<MenuItem Header="File">
<MenuItem Header="Recent files" ItemsSource="{Binding RecentFiles}"><MenuItem.ItemTemplate><DataTemplate x:DataType="x:String"><Button Content="{Binding}" Click="RecentFileClick" /></DataTemplate></MenuItem.ItemTemplate></MenuItem>
<MenuItem Header="New" Command="{Binding Actions[subtitle/new]}" />
<MenuItem Header="Open…" Command="{Binding Actions[subtitle/open]}" />
<MenuItem Header="Save" Command="{Binding Actions[subtitle/save]}" />
<MenuItem Header="Save As…" Command="{Binding Actions[subtitle/save-as]}" />
<MenuItem Header="Reload from disk…" Command="{Binding Actions[subtitle/revert]}" />
<MenuItem Header="Close tab" Command="{Binding Actions[subtitle/close]}" />
</MenuItem>
<MenuItem Header="Edit">
<MenuItem Header="Undo" Command="{Binding Actions[edit/undo]}" />
<MenuItem Header="Redo" Command="{Binding Actions[edit/redo]}" />
<MenuItem Header="Copy lines" Command="{Binding Actions[grid/copy]}" />
<MenuItem Header="Cut lines" Command="{Binding Actions[grid/cut]}" />
<MenuItem Header="Paste lines" Command="{Binding Actions[grid/paste]}" />
<MenuItem Header="Select all lines" Command="{Binding Actions[grid/select-all]}" />
<MenuItem Header="Find / Replace…" Command="{Binding Actions[edit/find]}" />
</MenuItem>
<MenuItem Header="Subtitle">
<MenuItem Header="Insert before" Command="{Binding Actions[grid/insert/before]}" />
<MenuItem Header="Insert after" Command="{Binding Actions[grid/insert/after]}" />
<MenuItem Header="Duplicate" Command="{Binding Actions[grid/duplicate]}" />
<MenuItem Header="Delete selected" Command="{Binding Actions[grid/delete]}" />
<MenuItem Header="Dialogue / Comment" Command="{Binding Actions[grid/toggle-comment]}" />
<MenuItem Header="Split at text cursor" Command="{Binding Actions[grid/split]}" />
<MenuItem Header="Join selected" Command="{Binding Actions[grid/join]}" />
<MenuItem Header="Move up" Command="{Binding Actions[grid/move/up]}" />
<MenuItem Header="Move down" Command="{Binding Actions[grid/move/down]}" />
<MenuItem Header="Styles Manager…" Command="{Binding Actions[styles/manage]}" />
<MenuItem Header="Script Info…" Command="{Binding Actions[script-info/edit]}" />
</MenuItem>
<MenuItem Header="Timing">
<MenuItem Header="Set start to current time" Command="{Binding Actions[timing/set-start]}" />
<MenuItem Header="Set end to current time" Command="{Binding Actions[timing/set-end]}" />
<MenuItem Header="Jump to line start" Command="{Binding Actions[timing/jump-start]}" />
<MenuItem Header="Jump to line end" Command="{Binding Actions[timing/jump-end]}" />
<MenuItem Header="Previous subtitle" Command="{Binding Actions[grid/line/previous]}" />
<MenuItem Header="Next subtitle" Command="{Binding Actions[grid/line/next]}" />
</MenuItem>
<MenuItem Header="Video">
<MenuItem Header="Open video/audio…" Command="{Binding Actions[media/open]}" />
<MenuItem Header="Play / Pause" Command="{Binding Actions[video/play]}" />
<MenuItem Header="Stop" Command="{Binding Actions[video/stop]}" />
<MenuItem Header="Previous frame" Command="{Binding Actions[video/frame/previous]}" />
<MenuItem Header="Next frame" Command="{Binding Actions[video/frame/next]}" />
<MenuItem Header="Position tool" Command="{Binding Actions[video/tool/position]}" />
<MenuItem Header="Clip tool" Command="{Binding Actions[video/tool/clip]}" />
</MenuItem>
<MenuItem Header="Audio">
<MenuItem Header="Play current line" Command="{Binding Actions[audio/play/selection]}" />
<MenuItem Header="Play from cursor" Command="{Binding Actions[audio/play/cursor]}" />
<MenuItem Header="Zoom in" Command="{Binding Actions[audio/zoom/in]}" />
<MenuItem Header="Zoom out" Command="{Binding Actions[audio/zoom/out]}" />
</MenuItem>
<MenuItem Header="View">
<MenuItem Header="Cycle theme" Command="{Binding Actions[view/theme/cycle]}" />
</MenuItem>
</Menu><DockPanel Grid.Row="1" Margin="6,2"><TextBlock DockPanel.Dock="Right" MaxWidth="580" Text="{Binding SubtitleStatus}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" Spacing="4">
<Button Content="New" Command="{Binding NewDocumentCommand}" Padding="6,1" ToolTip.Tip="Ctrl+N" /><Button Content="Open ASS" Command="{Binding Actions[subtitle/open]}" Padding="6,1" ToolTip.Tip="Ctrl+O" /><Button Content="Save" Command="{Binding Actions[subtitle/save]}" Padding="6,1" ToolTip.Tip="Ctrl+S" /><Button Content="Open media" Command="{Binding Actions[media/open]}" Padding="6,1" />
<Button Command="{Binding UndoCommand}" Padding="6,1" ToolTip.Tip="Undo (Ctrl+Z)"><PathIcon Width="15" Height="15" Data="{x:Static icons:IconGeometries.Undo}" /></Button><Button Command="{Binding RedoCommand}" Padding="6,1" ToolTip.Tip="Redo (Ctrl+Y)"><PathIcon Width="15" Height="15" Data="{x:Static icons:IconGeometries.Redo}" /></Button>
</StackPanel></DockPanel></Grid></Border>
<Grid Grid.Row="2" ColumnDefinitions="2*,4,3*" Name="UpperWorkspace">
  <Grid Grid.Column="0" RowDefinitions="*,4,42" Name="VisualColumn">
    <Border Grid.Row="0" Margin="6,6,3,3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
      <Grid Name="VideoRegion" RowDefinitions="24,*,34,28">
        <TextBlock Text="VIDEO" FontWeight="SemiBold" Margin="7,3" />
        <Border Grid.Row="1" Margin="5,0" Background="Black" ClipToBounds="True"><Grid><Image Name="VideoImage" Source="{Binding VideoFrame}" Stretch="Uniform" /><controls:VisualOverlayControl Name="VisualOverlay" Model="{Binding}" /></Grid></Border>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="4" Margin="5,2">
          <Button Content="{Binding PlayPauseText}" Command="{Binding Actions[video/play]}" Padding="5,1" /><Button Grid.Column="1" Content="Stop" Command="{Binding Actions[video/stop]}" Padding="5,1" />
          <Slider Grid.Column="2" Minimum="0" Maximum="{Binding MediaDurationSeconds}" Value="{Binding CurrentTimeSeconds, Mode=TwoWay}" PointerReleased="VideoSeekReleased" />
          <TextBlock Grid.Column="3" Text="{Binding TimeDisplay}" VerticalAlignment="Center" FontSize="11" /><TextBlock Grid.Column="4" Text="{Binding DurationDisplay}" VerticalAlignment="Center" Opacity="0.65" FontSize="11" />
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4" Margin="5,0">
          <Button Content="Previous frame" Command="{Binding Actions[video/frame/previous]}" Padding="4,0" /><Button Content="Next frame" Command="{Binding Actions[video/frame/next]}" Padding="4,0" />
          <TextBox Name="ExactTime" Width="100" Padding="4,0" PlaceholderText="h:mm:ss.cc" /><Button Content="Seek" Command="{Binding Actions[video/seek]}" CommandParameter="{Binding #ExactTime.Text}" Padding="4,0" />
        </StackPanel>
      </Grid>
    </Border>
    <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="{DynamicResource SplitterBrush}" />
    <Border Grid.Row="2" Margin="6,3,3,6" Background="{DynamicResource PanelBrush}"><StackPanel Orientation="Horizontal" Spacing="4" Margin="6,2">
      <TextBlock Text="VISUAL TOOLS" FontSize="11" VerticalAlignment="Center" />
      <Button Command="{Binding PositionToolCommand}" Padding="5,1" ToolTip.Tip="Position: drag on video"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Position}" /></Button>
      <Button Command="{Binding ClipToolCommand}" Padding="5,1" ToolTip.Tip="Clip: drag to create rectangle; drag handles to edit; Shift+drag moves clip"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Clip}" /></Button>
      <TextBlock Text="{Binding ActiveVisualTool}" FontSize="11" VerticalAlignment="Center" /><CheckBox Content="New clip inverse" IsChecked="{Binding InverseClip, Mode=TwoWay}" FontSize="11" />
    </StackPanel></Border>
  </Grid>
  <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SplitterBrush}" />
  <Grid Grid.Column="2" RowDefinitions="150,4,*" Name="TemporalTextColumn">
    <Border Grid.Row="0" Margin="3,6,6,3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
      <Grid Name="AudioRegion" RowDefinitions="26,*,20">
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,1"><TextBlock Text="AUDIO" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="−" Command="{Binding Actions[audio/zoom/out]}" Padding="5,0" /><Button Content="+" Command="{Binding Actions[audio/zoom/in]}" Padding="5,0" /><Button Content="Play line" Command="{Binding Actions[audio/play/selection]}" Padding="5,0" /><ComboBox Name="AudioMode" SelectedIndex="0" SelectionChanged="AudioModeChanged" Padding="5,0"><ComboBoxItem Content="Waveform" /><ComboBoxItem Content="Spectrogram" /></ComboBox></StackPanel>
        <controls:AudioWaveformControl Name="AudioDisplay" ToolTip.Tip="Click: seek · Green/red: drag start/end · Shift+drag inside line: move timing · Wheel: scroll · Ctrl+wheel: zoom" Grid.Row="1" Margin="5,0" Model="{Binding}" Samples="{Binding WaveformSamples}" Stroke="{DynamicResource IconAccentBrush}" />
        <TextBlock Grid.Row="2" Text="{Binding MediaStatus}" TextTrimming="CharacterEllipsis" FontSize="10" Margin="6,1" />
      </Grid>
    </Border>
    <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="{DynamicResource SplitterBrush}" />
    <Border Grid.Row="2" Margin="3,3,6,6" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
      <Grid Name="EventEditorRegion" Margin="6" RowDefinitions="24,28,28,28,24,*" IsEnabled="{Binding HasSelectedEvent}">
        <DockPanel><TextBlock Text="EDIT PANEL" FontWeight="SemiBold" FontSize="12" /><Button Content="Commit (Ctrl+Enter)" Command="{Binding Actions[edit/commit]}" Padding="5,0" HorizontalAlignment="Right" /><TextBlock Text="{Binding SelectedEvent.Duration, StringFormat='Duration {0}'}" Margin="8,0" FontSize="11" /></DockPanel>
        <Grid Grid.Row="1" ColumnDefinitions="40,*,34,*,38,60" ColumnSpacing="4"><TextBlock Text="Start" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Draft.Start, Mode=TwoWay}" Padding="4,1" /><TextBlock Grid.Column="2" Text="End" VerticalAlignment="Center" /><TextBox Grid.Column="3" Text="{Binding Draft.End, Mode=TwoWay}" Padding="4,1" /><TextBlock Grid.Column="4" Text="Layer" VerticalAlignment="Center" /><TextBox Grid.Column="5" Text="{Binding Draft.Layer, Mode=TwoWay}" Padding="4,1" /></Grid>
        <Grid Grid.Row="2" ColumnDefinitions="40,*,40,*" ColumnSpacing="4"><TextBlock Text="Style" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding StyleNames}" SelectedItem="{Binding Draft.Style, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="4,1" /><TextBlock Grid.Column="2" Text="Actor" VerticalAlignment="Center" /><AutoCompleteBox Grid.Column="3" ItemsSource="{Binding ActorNames}" Text="{Binding Draft.Actor, Mode=TwoWay}" MinimumPrefixLength="1" Padding="4,1" /></Grid>
        <Grid Grid.Row="3" ColumnDefinitions="40,*,18,54,18,54,18,54" ColumnSpacing="4"><TextBlock Text="Effect" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Draft.Effect, Mode=TwoWay}" Padding="4,1" /><TextBlock Grid.Column="2" Text="L" VerticalAlignment="Center" /><TextBox Grid.Column="3" Text="{Binding Draft.MarginL, Mode=TwoWay}" Padding="4,1" /><TextBlock Grid.Column="4" Text="R" VerticalAlignment="Center" /><TextBox Grid.Column="5" Text="{Binding Draft.MarginR, Mode=TwoWay}" Padding="4,1" /><TextBlock Grid.Column="6" Text="V" VerticalAlignment="Center" /><TextBox Grid.Column="7" Text="{Binding Draft.MarginV, Mode=TwoWay}" Padding="4,1" /></Grid>
        <TextBlock Grid.Row="4" Text="Enter: commit and next · Shift+Enter: newline · Ctrl+Shift+D: split" FontSize="10" VerticalAlignment="Center" />
        <TextBox Name="SubtitleText" Grid.Row="5" FontSize="14" Padding="5" Text="{Binding Draft.Text, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" PlaceholderText="Select a subtitle row" />
      </Grid>
    </Border>
  </Grid>
</Grid>
<GridSplitter Grid.Row="3" ResizeDirection="Rows" Background="{DynamicResource SplitterBrush}" />
<Border Grid.Row="4" Margin="6" Name="SubtitleGridRegion" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
<Grid RowDefinitions="26,24,*"><DockPanel Margin="6,1"><TextBlock Text="SUBTITLE GRID" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" /><StackPanel Orientation="Horizontal" Spacing="4"><Button Content="Insert" Command="{Binding Actions[grid/insert/after]}" Padding="5,0" /><Button Content="Duplicate" Command="{Binding Actions[grid/duplicate]}" Padding="5,0" /><Button Content="Delete" Command="{Binding Actions[grid/delete]}" Padding="5,0" /><Button Content="Styles…" Command="{Binding Actions[styles/manage]}" Padding="5,0" /></StackPanel></DockPanel>
<Border Grid.Row="1" Padding="10,2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"><Grid Name="ColumnHeader" PointerPressed="HeaderPressed" PointerMoved="HeaderMoved" PointerReleased="HeaderReleased" ColumnDefinitions="40,65,48,92,92,110,100,90,*" ColumnSpacing="4" ToolTip.Tip="Drag a column boundary to resize"><TextBlock Text="#" /><TextBlock Grid.Column="1" Text="Type" /><TextBlock Grid.Column="2" Text="Layer" /><TextBlock Grid.Column="3" Text="Start" /><TextBlock Grid.Column="4" Text="End" /><TextBlock Grid.Column="5" Text="Style" /><TextBlock Grid.Column="6" Text="Actor" /><TextBlock Grid.Column="7" Text="Effect" /><TextBlock Grid.Column="8" Text="Text" /></Grid></Border>
<ListBox Name="SubtitleRows" Grid.Row="2" ItemsSource="{Binding Events}" SelectionMode="Multiple" AutoScrollToSelectedItem="True" BorderThickness="0" SelectionChanged="GridSelectionChanged">
<ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="6,2" /></Style></ListBox.Styles>
<ListBox.ContextMenu><ContextMenu>
<MenuItem Header="Insert before" Command="{Binding Actions[grid/insert/before]}" />
<MenuItem Header="Insert after" Command="{Binding Actions[grid/insert/after]}" />
<MenuItem Header="Duplicate" Command="{Binding Actions[grid/duplicate]}" />
<MenuItem Header="Delete selected" Command="{Binding Actions[grid/delete]}" />
<MenuItem Header="Dialogue / Comment" Command="{Binding Actions[grid/toggle-comment]}" />
<MenuItem Header="Split at text cursor" Command="{Binding Actions[grid/split]}" />
<MenuItem Header="Join selected" Command="{Binding Actions[grid/join]}" />
<MenuItem Header="Move up" Command="{Binding Actions[grid/move/up]}" />
<MenuItem Header="Move down" Command="{Binding Actions[grid/move/down]}" />
<MenuItem Header="Styles Manager…" Command="{Binding Actions[styles/manage]}" />
<MenuItem Header="Copy lines" Command="{Binding Actions[grid/copy]}" />
<MenuItem Header="Cut lines" Command="{Binding Actions[grid/cut]}" />
<MenuItem Header="Paste lines" Command="{Binding Actions[grid/paste]}" />
<MenuItem Header="Select all lines" Command="{Binding Actions[grid/select-all]}" />
</ContextMenu></ListBox.ContextMenu><ListBox.ItemTemplate><DataTemplate x:DataType="sub:AssEvent"><Grid Tag="SubtitleRow" ColumnDefinitions="40,65,48,92,92,110,100,90,*" ColumnSpacing="4">
<Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource IconAccentBrush}" IsVisible="{Binding IsCurrent}" /><Border Grid.ColumnSpan="9" Background="{DynamicResource IconAccentBrush}" Opacity="0.12" IsVisible="{Binding IsActive}" /><TextBlock Text="{Binding Number}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="11" /><TextBlock Grid.Column="2" Text="{Binding Layer}" FontSize="11" /><TextBlock Grid.Column="3" Text="{Binding Start}" FontSize="11" /><TextBlock Grid.Column="4" Text="{Binding End}" FontSize="11" /><TextBlock Grid.Column="5" Text="{Binding Style}" TextTrimming="CharacterEllipsis" FontSize="11" /><TextBlock Grid.Column="6" Text="{Binding Actor}" TextTrimming="CharacterEllipsis" FontSize="11" /><TextBlock Grid.Column="7" Text="{Binding Effect}" TextTrimming="CharacterEllipsis" FontSize="11" /><TextBlock Grid.Column="8" Text="{Binding Text}" TextTrimming="CharacterEllipsis" FontSize="12" />
</Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border></Grid></Window>
