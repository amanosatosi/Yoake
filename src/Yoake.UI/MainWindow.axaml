<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yoake.UI.ViewModels"
        xmlns:icons="using:Yoake.UI.Icons"
        xmlns:controls="using:Yoake.UI.Controls"
        xmlns:sub="using:Yoake.Core.Subtitles"
        x:Class="Yoake.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Yoake"
        Width="1440" Height="900"
        MinWidth="1040" MinHeight="728"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.Resources>
    <ControlTheme x:Key="AudioTrackButton" TargetType="RepeatButton">
      <Setter Property="Template"><ControlTemplate><Grid Background="Transparent"><Border Width="3" HorizontalAlignment="Center" Background="{TemplateBinding Background}" /></Grid></ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="AudioTrackThumb" TargetType="Thumb">
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" /></ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="AudioVerticalSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Width" Value="24" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Style Selector="^:vertical">
        <Setter Property="Template"><ControlTemplate>
          <Grid Name="SliderContainer" Background="Transparent" Margin="0,2">
            <Border Width="3" HorizontalAlignment="Center" Background="{DynamicResource IconForegroundBrush}" IsHitTestVisible="False" />
            <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Orientation="Vertical">
              <Track.DecreaseButton><RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource AudioTrackButton}" Background="{DynamicResource IconForegroundBrush}" Focusable="False" /></Track.DecreaseButton>
              <Track.IncreaseButton><RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource AudioTrackButton}" Background="{DynamicResource IconForegroundBrush}" Focusable="False" /></Track.IncreaseButton>
              <Thumb Name="SliderThumb" Width="18" Height="10" Theme="{StaticResource AudioTrackThumb}" Background="{DynamicResource VisualToolDetailBrush}" />
            </Track>
          </Grid>
        </ControlTemplate></Setter>
      </Style>
      <Style Selector="^:pointerover /template/ Thumb#SliderThumb"><Setter Property="Background" Value="{DynamicResource VisualToolPrimaryBrush}" /></Style>
      <Style Selector="^:disabled /template/ Grid#SliderContainer"><Setter Property="Opacity" Value="0.45" /></Style>
      <Style Selector="^:focus-visible /template/ Thumb#SliderThumb"><Setter Property="Background" Value="{DynamicResource VisualToolPrimaryBrush}" /></Style>
    </ControlTheme>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="ToggleButton.audioLink:checked /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource VisualToolWarningBrush}" /></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="24" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="{DynamicResource YoakeUiRowHeight}" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="{DynamicResource YoakeUiRowHeight}" /></Style>
    <Style Selector="CheckBox"><Setter Property="MinHeight" Value="24" /></Style>
    <Style Selector="Border.document-tab"><Setter Property="Background" Value="{DynamicResource TabBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" /></Style>
    <Style Selector="Border.document-tab.active"><Setter Property="BorderBrush" Value="{DynamicResource TabAccentBrush}" /></Style>
    <Style Selector="Border.document-tab TextBlock.tab-title"><Setter Property="Foreground" Value="{DynamicResource IconForegroundBrush}" /></Style>
  </Window.Styles>
  <Grid>
    <!-- Reserve 140 DIP for actual rows, plus the 24-DIP header, borders and margins. -->
    <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="36" /><RowDefinition Height="Auto" MinHeight="24" /><RowDefinition Height="3*" MinHeight="444" /><RowDefinition Height="4" /><RowDefinition Height="2*" MinHeight="178" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Name="TitleTabStrip" Background="{DynamicResource TabStripBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*">
        <ScrollViewer Name="TabScroll" Grid.Column="0" MaxWidth="760" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl Name="DocumentTabs" ItemsSource="{Binding Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DocumentTabViewModel">
                <Border Classes="document-tab" Classes.active="{Binding IsActive}" Margin="2,3,0,2" CornerRadius="5" BorderThickness="1">
                  <Grid Width="190" Height="{DynamicResource YoakeUiTabContentHeight}" ColumnDefinitions="*,Auto,Auto">
                    <Button Name="ActivateDocumentTab" Grid.Column="0" Padding="9,2" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ActivateCommand}" ToolTip.Tip="{Binding DisplayTitle}">
                      <TextBlock Classes="tab-title" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <TextBlock Grid.Column="1" Text="*" FontWeight="Bold" VerticalAlignment="Center" IsVisible="{Binding IsDirty}" ToolTip.Tip="Unsaved changes" Foreground="{DynamicResource TabAccentBrush}" />
                    <Button Name="CloseDocumentTab" Grid.Column="2" Width="28" Padding="6" Background="Transparent" BorderThickness="0" Command="{Binding CloseCommand}" ToolTip.Tip="Close tab">
                      <PathIcon Width="11" Height="11" Data="{x:Static icons:IconGeometries.Close}" Foreground="{DynamicResource IconForegroundBrush}" />
                    </Button>
                    <Border Grid.ColumnSpan="3" Height="3" Margin="7,0" VerticalAlignment="Bottom" CornerRadius="2" Background="{DynamicResource TabAccentBrush}" IsVisible="{Binding IsActive}" IsHitTestVisible="False" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Button Name="NewDocumentTab" Grid.Column="1" Width="34" Height="30" Margin="4,2" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding NewDocumentCommand}" ToolTip.Tip="New subtitle tab" AutomationProperties.Name="New subtitle tab">
          <TextBlock Text="+" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Button>
        <Border Grid.Column="2" WindowDecorationProperties.ElementRole="TitleBar" Background="Transparent" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource CommandBarBrush}"><Grid RowDefinitions="Auto,Auto"><Menu MinHeight="24">
<MenuItem Name="FileMenu" Header="File">
<MenuItem Header="Recent files" ItemsSource="{Binding RecentFiles}"><MenuItem.ItemTemplate><DataTemplate x:DataType="x:String"><Button Content="{Binding}" Click="RecentFileClick" /></DataTemplate></MenuItem.ItemTemplate></MenuItem>
<MenuItem Name="NewMenu" Header="New" InputGesture="{Binding Actions[subtitle/new].InputGesture}" Command="{Binding Actions[subtitle/new]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.New}" /></MenuItem.Icon></MenuItem>
<MenuItem Name="OpenEmbeddedSubtitlesMenu" Header="Open subtitles from video…" Command="{Binding Actions[subtitle/open/video]}" />
<MenuItem Name="OpenCharsetMenu" Header="Open with character set…" Command="{Binding Actions[subtitle/open/charset]}" />
<MenuItem Header="Open…" InputGesture="{Binding Actions[subtitle/open].InputGesture}" Command="{Binding Actions[subtitle/open]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Open}" /></MenuItem.Icon></MenuItem>
<MenuItem Name="RecoveryMenu" Header="Recover Subtitles…" InputGesture="{Binding Actions[subtitle/open/autosave].InputGesture}" Command="{Binding Actions[subtitle/open/autosave]}" />
<MenuItem Name="AttachmentsMenu" Header="Attachments…" InputGesture="{Binding Actions[subtitle/attachment].InputGesture}" Command="{Binding Actions[subtitle/attachment]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Attachments}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Save" InputGesture="{Binding Actions[subtitle/save].InputGesture}" Command="{Binding Actions[subtitle/save]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Save}" /></MenuItem.Icon></MenuItem>
<MenuItem Name="SaveUtf8Menu" Header="Save As UTF-8…" Command="{Binding Actions[subtitle/save/utf8]}" />
<MenuItem Header="Save As…" InputGesture="{Binding Actions[subtitle/save-as].InputGesture}" Command="{Binding Actions[subtitle/save-as]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.SaveAs}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Export subtitles…" InputGesture="{Binding Actions[automation/export].InputGesture}" Command="{Binding Actions[automation/export]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Export}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Reload from disk…" InputGesture="{Binding Actions[subtitle/revert].InputGesture}" Command="{Binding Actions[subtitle/revert]}" />
<MenuItem Header="Exit" InputGesture="{Binding Actions[app/exit].InputGesture}" Command="{Binding Actions[app/exit]}" />
<MenuItem Header="Close tab" InputGesture="{Binding Actions[subtitle/close].InputGesture}" Command="{Binding Actions[subtitle/close]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Close}" /></MenuItem.Icon></MenuItem>
</MenuItem>
<MenuItem Name="EditMenu" Header="Edit">
<MenuItem Header="Join Next (translator mode)" Command="{Binding Actions[edit/line/join/next/translatormode]}" InputGesture="{Binding Actions[edit/line/join/next/translatormode].InputGesture}" />
<MenuItem Header="Join Last" Command="{Binding Actions[edit/line/join/last]}" InputGesture="{Binding Actions[edit/line/join/last].InputGesture}" />
<MenuItem Name="OptionsMenu" Header="Options…" InputGesture="{Binding Actions[app/options].InputGesture}" Command="{Binding Actions[app/options]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Options}" /></MenuItem.Icon></MenuItem>
<MenuItem Name="UndoMenu" Header="{Binding Actions[edit/undo].Label}" InputGesture="{Binding Actions[edit/undo].InputGesture}" Command="{Binding Actions[edit/undo]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Undo}" /></MenuItem.Icon></MenuItem>
<MenuItem Name="RedoMenu" Header="{Binding Actions[edit/redo].Label}" InputGesture="{Binding Actions[edit/redo].InputGesture}" Command="{Binding Actions[edit/redo]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Redo}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Copy lines" InputGesture="{Binding Actions[grid/copy].InputGesture}" Command="{Binding Actions[grid/copy]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Copy}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Cut lines" InputGesture="{Binding Actions[grid/cut].InputGesture}" Command="{Binding Actions[grid/cut]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Cut}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Paste lines" InputGesture="{Binding Actions[grid/paste].InputGesture}" Command="{Binding Actions[grid/paste]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Paste}" /></MenuItem.Icon></MenuItem>
<MenuItem Name="PasteOverMenu" Header="Paste Lines Over…" InputGesture="{Binding Actions[edit/line/paste/over].InputGesture}" Command="{Binding Actions[edit/line/paste/over]}" />
<MenuItem Name="ShowOriginalMenu" Header="Show Original" ToggleType="CheckBox" IsChecked="{Binding ShowOriginal, Mode=OneWay}" Command="{Binding Actions[edit/show_original]}" />
<MenuItem Header="Insert Original" Command="{Binding Actions[edit/insert_original]}" InputGesture="{Binding Actions[edit/insert_original].InputGesture}" />
<MenuItem Header="Revert to original" Command="{Binding Actions[edit/revert]}" InputGesture="{Binding Actions[edit/revert].InputGesture}" />
<MenuItem Header="Select all lines" InputGesture="{Binding Actions[grid/select-all].InputGesture}" Command="{Binding Actions[grid/select-all]}" />
<MenuItem Name="SelectLinesMenu" Header="Select Lines…" InputGesture="{Binding Actions[tool/line/select].InputGesture}" Command="{Binding Actions[tool/line/select]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.SelectLines}" /></MenuItem.Icon></MenuItem>
<MenuItem Name="SelectVisibleMenu" Header="Select visible lines" InputGesture="{Binding Actions[subtitle/select/visible].InputGesture}" Command="{Binding Actions[subtitle/select/visible]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.SelectVisible}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Clear line text" InputGesture="{Binding Actions[edit/clear].InputGesture}" Command="{Binding Actions[edit/clear]}" />
<MenuItem Header="Clear visible text" InputGesture="{Binding Actions[edit/clear/text].InputGesture}" Command="{Binding Actions[edit/clear/text]}" />
<MenuItem Header="Find…" InputGesture="{Binding Actions[edit/find].InputGesture}" Command="{Binding Actions[edit/find]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Find}" /></MenuItem.Icon></MenuItem>
<MenuItem Name="FindNextMenu" Header="Find next" InputGesture="{Binding Actions[subtitle/find/next].InputGesture}" Command="{Binding Actions[subtitle/find/next]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.FindNext}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Find / Replace…" InputGesture="{Binding Actions[edit/find_replace].InputGesture}" Command="{Binding Actions[edit/find_replace]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Replace}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Cancel background operation" Command="{Binding Actions[editor/cancel-operation]}" />
</MenuItem>
<MenuItem Name="SubtitleMenu" Header="Subtitle">
<MenuItem Header="Insert before" InputGesture="{Binding Actions[grid/insert/before].InputGesture}" Command="{Binding Actions[grid/insert/before]}" />
<MenuItem Header="Insert after" InputGesture="{Binding Actions[grid/insert/after].InputGesture}" Command="{Binding Actions[grid/insert/after]}" />
<MenuItem Header="Insert before at video time" Command="{Binding Actions[subtitle/insert/before/videotime]}" InputGesture="{Binding Actions[subtitle/insert/before/videotime].InputGesture}" />
<MenuItem Header="Insert after at video time" Command="{Binding Actions[subtitle/insert/after/videotime]}" InputGesture="{Binding Actions[subtitle/insert/after/videotime].InputGesture}" />
<MenuItem Header="Duplicate" InputGesture="{Binding Actions[grid/duplicate].InputGesture}" Command="{Binding Actions[grid/duplicate]}" />
<MenuItem Header="Delete selected" InputGesture="{Binding Actions[grid/delete].InputGesture}" Command="{Binding Actions[grid/delete]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Delete}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Comment / Uncomment Lines" InputGesture="{Binding Actions[grid/toggle-comment].InputGesture}" Command="{Binding Actions[grid/toggle-comment]}" />
<MenuItem Header="Split at text cursor">
<MenuItem Header="Preserve times" InputGesture="{Binding Actions[edit/line/split/preserve].InputGesture}" Command="{Binding Actions[edit/line/split/preserve]}" />
<MenuItem Header="Estimate times" InputGesture="{Binding Actions[edit/line/split/estimate].InputGesture}" Command="{Binding Actions[edit/line/split/estimate]}" />
<MenuItem Header="At video frame" InputGesture="{Binding Actions[edit/line/split/video].InputGesture}" Command="{Binding Actions[edit/line/split/video]}" />
<MenuItem Header="Divide time equally" InputGesture="{Binding Actions[grid/split].InputGesture}" Command="{Binding Actions[grid/split]}" />
</MenuItem>
<MenuItem Name="RecombineMenu" Header="Recombine lines" Command="{Binding Actions[edit/line/recombine]}" InputGesture="{Binding Actions[edit/line/recombine].InputGesture}" />
<MenuItem Name="SplitByKaraokeMenu" Header="Split by karaoke" InputGesture="{Binding Actions[edit/line/split/by_karaoke].InputGesture}" Command="{Binding Actions[edit/line/split/by_karaoke]}" />
<MenuItem Header="Split before current frame" InputGesture="{Binding Actions[edit/line/split/before].InputGesture}" Command="{Binding Actions[edit/line/split/before]}" />
<MenuItem Header="Split after current frame" InputGesture="{Binding Actions[edit/line/split/after].InputGesture}" Command="{Binding Actions[edit/line/split/after]}" />
<MenuItem Header="Join selected">
<MenuItem Header="Concatenate" InputGesture="{Binding Actions[edit/line/join/concatenate].InputGesture}" Command="{Binding Actions[edit/line/join/concatenate]}" />
<MenuItem Header="Keep first text" InputGesture="{Binding Actions[edit/line/join/keep_first].InputGesture}" Command="{Binding Actions[edit/line/join/keep_first]}" />
<MenuItem Header="As karaoke" InputGesture="{Binding Actions[edit/line/join/as_karaoke].InputGesture}" Command="{Binding Actions[edit/line/join/as_karaoke]}" />
<MenuItem Header="With line breaks" InputGesture="{Binding Actions[grid/join].InputGesture}" Command="{Binding Actions[grid/join]}" />
</MenuItem>
<MenuItem Header="Swap selected lines" InputGesture="{Binding Actions[grid/swap].InputGesture}" Command="{Binding Actions[grid/swap]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.StyleSort}" /></MenuItem.Icon></MenuItem>
<MenuItem Name="SortAllLinesMenu" Header="Sort all lines">
<MenuItem Header="By start" InputGesture="{Binding Actions[grid/sort/start].InputGesture}" Command="{Binding Actions[grid/sort/start]}" />
<MenuItem Header="By end" InputGesture="{Binding Actions[grid/sort/end].InputGesture}" Command="{Binding Actions[grid/sort/end]}" />
<MenuItem Header="By style" InputGesture="{Binding Actions[grid/sort/style].InputGesture}" Command="{Binding Actions[grid/sort/style]}" />
<MenuItem Header="By actor" InputGesture="{Binding Actions[grid/sort/actor].InputGesture}" Command="{Binding Actions[grid/sort/actor]}" />
<MenuItem Header="By effect" InputGesture="{Binding Actions[grid/sort/effect].InputGesture}" Command="{Binding Actions[grid/sort/effect]}" />
<MenuItem Header="By layer" InputGesture="{Binding Actions[grid/sort/layer].InputGesture}" Command="{Binding Actions[grid/sort/layer]}" />
<MenuItem Name="SortAllTextMenu" Header="By text including tags" Command="{Binding Actions[grid/sort/text]}" InputGesture="{Binding Actions[grid/sort/text].InputGesture}" />
<MenuItem Header="By text without tags" Command="{Binding Actions[grid/sort/text_stripped]}" InputGesture="{Binding Actions[grid/sort/text_stripped].InputGesture}" />
</MenuItem>
<MenuItem Header="Sort selected blocks">
<MenuItem Header="By start" InputGesture="{Binding Actions[grid/sort/start/selected].InputGesture}" Command="{Binding Actions[grid/sort/start/selected]}" />
<MenuItem Header="By end" InputGesture="{Binding Actions[grid/sort/end/selected].InputGesture}" Command="{Binding Actions[grid/sort/end/selected]}" />
<MenuItem Header="By style" InputGesture="{Binding Actions[grid/sort/style/selected].InputGesture}" Command="{Binding Actions[grid/sort/style/selected]}" />
<MenuItem Header="By actor" InputGesture="{Binding Actions[grid/sort/actor/selected].InputGesture}" Command="{Binding Actions[grid/sort/actor/selected]}" />
<MenuItem Header="By effect" InputGesture="{Binding Actions[grid/sort/effect/selected].InputGesture}" Command="{Binding Actions[grid/sort/effect/selected]}" />
<MenuItem Header="By layer" InputGesture="{Binding Actions[grid/sort/layer/selected].InputGesture}" Command="{Binding Actions[grid/sort/layer/selected]}" />
<MenuItem Header="By text including tags" Command="{Binding Actions[grid/sort/text/selected]}" InputGesture="{Binding Actions[grid/sort/text/selected].InputGesture}" />
<MenuItem Header="By text without tags" Command="{Binding Actions[grid/sort/text_stripped/selected]}" InputGesture="{Binding Actions[grid/sort/text_stripped/selected].InputGesture}" />
</MenuItem>
<MenuItem Header="Move up" InputGesture="{Binding Actions[grid/move/up].InputGesture}" Command="{Binding Actions[grid/move/up]}" />
<MenuItem Header="Move down" InputGesture="{Binding Actions[grid/move/down].InputGesture}" Command="{Binding Actions[grid/move/down]}" />
<MenuItem Header="Styles Manager…" InputGesture="{Binding Actions[styles/manage].InputGesture}" Command="{Binding Actions[styles/manage]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.StylesManager}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Select Lines…" InputGesture="{Binding Actions[tool/line/select].InputGesture}" Command="{Binding Actions[tool/line/select]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.SelectLines}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Select visible lines" InputGesture="{Binding Actions[subtitle/select/visible].InputGesture}" Command="{Binding Actions[subtitle/select/visible]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.SelectVisible}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Script Info…" InputGesture="{Binding Actions[script-info/edit].InputGesture}" Command="{Binding Actions[script-info/edit]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.ScriptProperties}" /></MenuItem.Icon></MenuItem>
</MenuItem>
<MenuItem Header="Timing">
<MenuItem Name="ShiftTimesMenu" Header="Shift Times…" InputGesture="{Binding Actions[time/shift].InputGesture}" Command="{Binding Actions[time/shift]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.ShiftTimes}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Make continuous"><MenuItem Header="Change starts" Command="{Binding Actions[time/continuous/start]}" /><MenuItem Header="Change ends" Command="{Binding Actions[time/continuous/end]}" /></MenuItem>
<MenuItem Header="Snap starts to video" InputGesture="{Binding Actions[time/snap/start_video].InputGesture}" Command="{Binding Actions[time/snap/start_video]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.StartToVideo}" Foreground="{DynamicResource IconTimingStartBrush}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Snap ends to video" InputGesture="{Binding Actions[time/snap/end_video].InputGesture}" Command="{Binding Actions[time/snap/end_video]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.EndToVideo}" Foreground="{DynamicResource IconTimingEndBrush}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Snap to scene" InputGesture="{Binding Actions[time/snap/scene].InputGesture}" Command="{Binding Actions[time/snap/scene]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.SnapScene}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Shift selection to current frame" InputGesture="{Binding Actions[time/frame/current].InputGesture}" Command="{Binding Actions[time/frame/current]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.ShiftToFrame}" /></MenuItem.Icon></MenuItem>
<Separator />
<MenuItem Header="Set start to current time" InputGesture="{Binding Actions[timing/set-start].InputGesture}" Command="{Binding Actions[timing/set-start]}" />
<MenuItem Header="Set end to current time" InputGesture="{Binding Actions[timing/set-end].InputGesture}" Command="{Binding Actions[timing/set-end]}" />
<MenuItem Header="Jump to line start" InputGesture="{Binding Actions[timing/jump-start].InputGesture}" Command="{Binding Actions[timing/jump-start]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.VideoToStart}" Foreground="{DynamicResource IconTimingStartBrush}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Jump to line end" InputGesture="{Binding Actions[timing/jump-end].InputGesture}" Command="{Binding Actions[timing/jump-end]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.VideoToEnd}" Foreground="{DynamicResource IconTimingEndBrush}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Previous subtitle" InputGesture="{Binding Actions[grid/line/previous].InputGesture}" Command="{Binding Actions[grid/line/previous]}" />
<MenuItem Header="Next subtitle" InputGesture="{Binding Actions[grid/line/next].InputGesture}" Command="{Binding Actions[grid/line/next]}" />
</MenuItem>
<MenuItem Name="VideoMenu" Header="Video">
<MenuItem Name="OpenVideoMenu" Header="Open video…" InputGesture="{Binding Actions[video/open].InputGesture}" Command="{Binding Actions[video/open]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.VideoOpen}" /></MenuItem.Icon></MenuItem>
<MenuItem Name="CloseVideoMenu" Header="Close video" InputGesture="{Binding Actions[video/close].InputGesture}" Command="{Binding Actions[video/close]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.VideoClose}" /></MenuItem.Icon></MenuItem>
<MenuItem Name="RecentVideoMenu" Header="Recent video" />
<MenuItem Name="OpenDummyVideoMenu" Header="Use dummy video…" Command="{Binding Actions[video/open/dummy]}" InputGesture="{Binding Actions[video/open/dummy].InputGesture}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.VideoDummy}" /></MenuItem.Icon></MenuItem>
<MenuItem Name="VideoDetailsMenu" Header="Show video details" Command="{Binding Actions[video/details]}" InputGesture="{Binding Actions[video/details].InputGesture}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.VideoDetails}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Track motion…" Command="{Binding Actions[video/motion-track]}" InputGesture="{Binding Actions[video/motion-track].InputGesture}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.MotionTrack}" /></MenuItem.Icon></MenuItem>
<MenuItem Name="VideoAspectMenu" Header="Aspect ratio">
<MenuItem Name="VideoAspectdefaultMenu" Header="Default" ToggleType="Radio" IsChecked="{Binding Actions[video/aspect/default].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/aspect/default]}" InputGesture="{Binding Actions[video/aspect/default].InputGesture}" />
<MenuItem Name="VideoAspectfullMenu" Header="Fullscreen (4:3)" ToggleType="Radio" IsChecked="{Binding Actions[video/aspect/full].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/aspect/full]}" InputGesture="{Binding Actions[video/aspect/full].InputGesture}" />
<MenuItem Name="VideoAspectwideMenu" Header="Widescreen (16:9)" ToggleType="Radio" IsChecked="{Binding Actions[video/aspect/wide].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/aspect/wide]}" InputGesture="{Binding Actions[video/aspect/wide].InputGesture}" />
<MenuItem Name="VideoAspectcinematicMenu" Header="Cinematic (2.35)" ToggleType="Radio" IsChecked="{Binding Actions[video/aspect/cinematic].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/aspect/cinematic]}" InputGesture="{Binding Actions[video/aspect/cinematic].InputGesture}" />
<MenuItem Name="VideoAspectcustomMenu" Header="Custom…" ToggleType="Radio" IsChecked="{Binding Actions[video/aspect/custom].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/aspect/custom]}" InputGesture="{Binding Actions[video/aspect/custom].InputGesture}" />
</MenuItem>
<MenuItem Name="VideoZoomMenu" Header="Set Zoom">
<MenuItem Name="VideoZoom50Menu" Header="50%" ToggleType="Radio" IsChecked="{Binding Actions[video/zoom/50].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/zoom/50]}" InputGesture="{Binding Actions[video/zoom/50].InputGesture}" />
<MenuItem Name="VideoZoom100Menu" Header="100%" ToggleType="Radio" IsChecked="{Binding Actions[video/zoom/100].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/zoom/100]}" InputGesture="{Binding Actions[video/zoom/100].InputGesture}" />
