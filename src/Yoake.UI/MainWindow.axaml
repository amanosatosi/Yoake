<MenuItem Name="StylingAssistantMenu" Header="Styling Assistant…" Command="{Binding Actions[tool/style/assistant]}" InputGesture="{Binding Actions[tool/style/assistant].InputGesture}" />
<MenuItem Name="ResampleMenu" Header="Resample Resolution…" InputGesture="{Binding Actions[tool/resampleres].InputGesture}" Command="{Binding Actions[tool/resampleres]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Resample}" /></MenuItem.Icon></MenuItem>
<MenuItem Name="FontCollectorMenu" Header="Fonts Collector…" InputGesture="{Binding Actions[tool/font_collector].InputGesture}" Command="{Binding Actions[tool/font_collector]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.FontCollector}" /></MenuItem.Icon></MenuItem>
</MenuItem>
</Menu><Grid Name="MainToolbar" MinHeight="42" IsVisible="{Binding ToolbarVisible}" Grid.Row="1" Margin="6,2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
<ScrollViewer Name="MainActionScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
<StackPanel Orientation="Horizontal" Spacing="2">
<Button Command="{Binding Actions[subtitle/new]}" Padding="4,2" ToolTip.Tip="New subtitle"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.New}" /></Button>
<Button Command="{Binding Actions[subtitle/open]}" Padding="4,2" ToolTip.Tip="Open subtitle"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Open}" /></Button>
<Button Command="{Binding Actions[subtitle/save]}" Padding="4,2" ToolTip.Tip="Save subtitle"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Save}" /></Button>
<Button Command="{Binding Actions[subtitle/save-as]}" Padding="4,2" ToolTip.Tip="Save subtitle as"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.SaveAs}" /></Button>
<Button Command="{Binding Actions[edit/undo]}" Padding="4,2" ToolTip.Tip="Undo"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Undo}" /></Button>
<Button Command="{Binding Actions[edit/redo]}" Padding="4,2" ToolTip.Tip="Redo"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Redo}" /></Button>
<Button Command="{Binding Actions[video/open]}" Padding="4,2" ToolTip.Tip="Open video"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.VideoOpen}" /></Button>
<Button Command="{Binding Actions[video/close]}" Padding="4,2" ToolTip.Tip="Close video"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.VideoClose}" /></Button>
<Button Command="{Binding Actions[audio/open]}" Padding="4,2" ToolTip.Tip="Open audio"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.AudioOpen}" /></Button>
<Button Command="{Binding Actions[audio/close]}" Padding="4,2" ToolTip.Tip="Close audio"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.AudioClose}" /></Button>
<Button Command="{Binding Actions[video/jump]}" Padding="4,2" ToolTip.Tip="Jump to frame or time"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.VideoJump}" /></Button>
<Button Command="{Binding Actions[video/zoom/in]}" Padding="4,2" ToolTip.Tip="Zoom video in"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.ZoomIn}" /></Button>
<Button Command="{Binding Actions[video/zoom/out]}" Padding="4,2" ToolTip.Tip="Zoom video out"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.ZoomOut}" /></Button>
<Button Command="{Binding Actions[timing/jump-start]}" Padding="4,2" ToolTip.Tip="Jump to subtitle start"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.VideoToStart}" Foreground="{DynamicResource IconTimingStartBrush}" /></Button>
<Button Command="{Binding Actions[timing/jump-end]}" Padding="4,2" ToolTip.Tip="Jump to subtitle end"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.VideoToEnd}" Foreground="{DynamicResource IconTimingEndBrush}" /></Button>
<Button Command="{Binding Actions[time/snap/start_video]}" Padding="4,2" ToolTip.Tip="Snap subtitle start to video"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.StartToVideo}" Foreground="{DynamicResource IconTimingStartBrush}" /></Button>
<Button Command="{Binding Actions[time/snap/end_video]}" Padding="4,2" ToolTip.Tip="Snap subtitle end to video"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.EndToVideo}" Foreground="{DynamicResource IconTimingEndBrush}" /></Button>
<Button Command="{Binding Actions[subtitle/select/visible]}" Padding="4,2" ToolTip.Tip="Select visible lines"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.SelectVisible}" /></Button>
<Button Command="{Binding Actions[time/snap/scene]}" Padding="4,2" ToolTip.Tip="Snap subtitles to scene"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.SnapScene}" /></Button>
<Button Command="{Binding Actions[time/frame/current]}" Padding="4,2" ToolTip.Tip="Shift selection to current frame"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.ShiftToFrame}" /></Button>
<Button Command="{Binding Actions[styles/manage]}" Padding="4,2" ToolTip.Tip="Styles Manager"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.StylesManager}" /></Button>
<Button Command="{Binding Actions[script-info/edit]}" Padding="4,2" ToolTip.Tip="Subtitle properties"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.ScriptProperties}" /></Button>
<Button Command="{Binding Actions[subtitle/attachment]}" Padding="4,2" ToolTip.Tip="Attachments"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Attachments}" /></Button>
<Button Command="{Binding Actions[tool/font_collector]}" Padding="4,2" ToolTip.Tip="Font Collector"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.FontCollector}" /></Button>
<Button Command="{Binding Actions[automation/manager]}" Padding="4,2" ToolTip.Tip="Automation Manager"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.AutomationManager}" /></Button>
<Button Command="{Binding Actions[time/shift]}" Padding="4,2" ToolTip.Tip="Shift times"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.ShiftTimes}" /></Button>
<Button Command="{Binding Actions[tool/resampleres]}" Padding="4,2" ToolTip.Tip="Resample resolution"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Resample}" /></Button>
<Button Command="{Binding Actions[app/options]}" Padding="4,2" ToolTip.Tip="Options"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Options}" /></Button>
<Button Command="{Binding Actions[grid/tag/cycle_hiding]}" Padding="4,2" ToolTip.Tip="Cycle tag display"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.TagDisplay}" /></Button>
</StackPanel></ScrollViewer>
<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><TextBlock Name="VisualToolStatus" MaxWidth="120" Text="{Binding VisualHint}" ToolTip.Tip="{Binding VisualHint}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource YoakeUiFontSizeTiny}" VerticalAlignment="Center" /><TextBlock MaxWidth="160" Text="{Binding SubtitleStatus}" ToolTip.Tip="{Binding SubtitleStatus}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></StackPanel>
</Grid></Grid></Border>
<Grid Grid.Row="2" Name="UpperWorkspace">
  <Grid.ColumnDefinitions><ColumnDefinition Width="6*" MinWidth="340" /><ColumnDefinition Width="4" /><ColumnDefinition Width="7*" MinWidth="480" /></Grid.ColumnDefinitions>
  <Grid Grid.Column="0" RowDefinitions="*,Auto" Name="VisualColumn" IsVisible="{Binding ShowEmbeddedVideo}">
    <Border Name="VideoDock" Grid.Row="0" Background="{DynamicResource PanelBrush}">
      <Grid Name="VideoRegion" Margin="3" VerticalAlignment="Top" RowDefinitions="Auto,16,Auto,Auto" RowSpacing="1">
        <Border Name="VideoCanvasHost" Background="Black" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Top"><Grid><controls:VideoPresentationControl Name="VideoImage" Model="{Binding}" /><controls:VisualOverlayControl Name="VisualOverlay" Model="{Binding}" /></Grid></Border>
        <controls:VideoFrameSlider Name="VideoSeekBar" Grid.Row="1" Model="{Binding}" />
        <Grid Name="VideoPlaybackControls" Grid.Row="2" ColumnDefinitions="Auto,*,*,Auto,Auto" RowDefinitions="Auto,0" ColumnSpacing="4">
          <Grid.Styles>
            <Style Selector="Border.video-position"><Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" /></Style>
            <Style Selector="Border.video-position.keyframe"><Setter Property="Background" Value="{DynamicResource VideoKeyframeReadoutBrush}" /></Style>
          </Grid.Styles>
          <StackPanel Name="VideoTransportButtons" Orientation="Horizontal" Spacing="1">
            <StackPanel.Styles>
              <Style Selector="Button, ToggleButton"><Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="2"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
            </StackPanel.Styles>
            <Button Name="VideoPlayButton" Command="{Binding Actions[video/play]}" ToolTip.Tip="Play or pause video" AutomationProperties.Name="Play or pause video"><Grid Width="20" Height="20"><Viewbox IsVisible="{Binding !IsPlaying}"><Canvas Width="24" Height="24"><Path Data="M7,4 L20,12 L7,20 Z" Fill="{DynamicResource VisualToolPrimaryBrush}"/></Canvas></Viewbox><Viewbox IsVisible="{Binding IsPlaying}"><Canvas Width="24" Height="24"><Path Data="M6,4 H10 V20 H6 Z M14,4 H18 V20 H14 Z" Fill="{DynamicResource VisualToolPrimaryBrush}"/></Canvas></Viewbox></Grid></Button>
            <Button Name="VideoPlayLineButton" Command="{Binding Actions[video/play/line]}" ToolTip.Tip="Play current subtitle line"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24" IsHitTestVisible="False"><Path Data="M2,4 H7 V6 H4 V18 H7 V20 H2 Z M17,4 H22 V20 H17 V18 H20 V6 H17 Z" Fill="{DynamicResource VisualToolPrimaryBrush}"/><Path Data="M8,6 L18,12 L8,18 Z" Fill="{DynamicResource VisualToolDetailBrush}"/></Canvas></Viewbox></Button>
            <Button Name="VideoStopButton" Command="{Binding Actions[video/stop]}" ToolTip.Tip="Stop video playback"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M5,5 H19 V19 H5 Z" Fill="{DynamicResource VisualToolWarningBrush}"/></Canvas></Viewbox></Button>
            <ToggleButton Name="VideoAutoSeekButton" Classes="authoring" IsChecked="{Binding Actions[video/autoseek].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/autoseek]}" ToolTip.Tip="Automatically seek video to the selected line" AutomationProperties.Name="Autoseek"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M2,4 H22 V20 H2 Z M4,6 V18 H20 V6 Z" Fill="{DynamicResource VisualToolDetailBrush}"/><Path Data="M6,10 H13 V7 L18,12 L13,17 V14 H6 Z" Fill="{DynamicResource VisualToolPrimaryBrush}"/></Canvas></Viewbox></ToggleButton>
          </StackPanel>
          <Border Name="VideoPositionBox" Grid.Column="1" Classes="video-position" Classes.keyframe="{Binding IsCurrentVideoKeyframe}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="2">
            <TextBox Name="VideoPosition" Text="{Binding FramePositionDisplay, Mode=OneWay}" IsReadOnly="True" Padding="3,0" BorderThickness="0" Background="Transparent" FontSize="{DynamicResource YoakeUiFontSizeSmall}" ToolTip.Tip="Current frame time and number; Ctrl+G jumps to frame or time" />
          </Border>
          <Border Name="VideoOffsetBox" Grid.Column="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="2">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="1">
              <Button Name="VideoStartOffset" Content="{Binding VideoStartOffsetDisplay}" FontSize="{DynamicResource YoakeUiFontSizeSmall}" Padding="2,0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTip.Tip="Milliseconds from subtitle start. Click to copy; right-click for fade in and insert." />
              <Button Name="VideoEndOffset" Grid.Column="1" Content="{Binding VideoEndOffsetDisplay}" FontSize="{DynamicResource YoakeUiFontSizeSmall}" Padding="2,0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTip.Tip="Milliseconds from subtitle end. Click to copy; right-click for fade out and insert." />
            </Grid>
          </Border>
          <ComboBox Name="VideoPlaybackSpeed" Grid.Column="3" Width="76" Padding="3,0" FontSize="{DynamicResource YoakeUiFontSizeSmall}" ItemsSource="{Binding VideoPlaybackSpeedChoices}" SelectedItem="{Binding VideoPlaybackSpeedText, Mode=TwoWay}" ToolTip.Tip="Video playback speed (audio pitch changes)" />
          <controls:VideoZoomControl Name="VideoZoom" Grid.Column="4" />
        </Grid>

    <Border Grid.Row="3" Name="VisualToolsBar" ToolTip.Tip="{Binding VisualHint}">
      <!-- Scoped styles stay with the shared video host when it is detached. -->
      <Border.Styles>
        <Style Selector="Button.visualTool, ToggleButton.visualTool">
          <Setter Property="Width" Value="24" />
          <Setter Property="Height" Value="24" />
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox">
          <Setter Property="Height" Value="{DynamicResource YoakeUiRowHeight}" />
          <Setter Property="MinHeight" Value="{DynamicResource YoakeUiRowHeight}" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="Padding" Value="3,0" />
        </Style>
        <Style Selector="Button.visualTool:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.visualTool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource TabBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        </Style>
        <Style Selector="ToggleButton.visualTool:checked /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource TabBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource VisualToolPrimaryBrush}" />
        </Style>
      </Border.Styles>
      <!-- All modes remain visible. Individual contextual controls wrap instead
           of being clipped or hidden behind a horizontal scrollbar. -->
      <controls:VisualToolbarLayout Name="VisualToolGroups" MinHeight="{DynamicResource YoakeUiRowHeight}">
        <WrapPanel Name="VisualPrimaryTools" Orientation="Horizontal" MinHeight="{DynamicResource YoakeUiRowHeight}">
        <ToggleButton Name="VisualToolCrosshair" Classes="visualTool" IsChecked="{Binding Actions[video/tool/crosshair].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/tool/crosshair]}" ToolTip.Tip="Crosshair" AutomationProperties.Name="Crosshair"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Crosshair" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="VisualToolPosition" Classes="visualTool" IsChecked="{Binding Actions[video/tool/position].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/tool/position]}" ToolTip.Tip="Position / timed movement" AutomationProperties.Name="Position / timed movement"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Position" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="VisualToolRotateZ" Classes="visualTool" IsChecked="{Binding Actions[video/tool/rotatez].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/tool/rotatez]}" ToolTip.Tip="Rotate Z" AutomationProperties.Name="Rotate Z"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Rotate" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="VisualToolRotateXY" Classes="visualTool" IsChecked="{Binding Actions[video/tool/rotatexy].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/tool/rotatexy]}" ToolTip.Tip="Rotate X/Y" AutomationProperties.Name="Rotate X/Y"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="RotateXY" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="VisualToolScale" Classes="visualTool" IsChecked="{Binding Actions[video/tool/scale].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/tool/scale]}" ToolTip.Tip="Scale" AutomationProperties.Name="Scale"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Scale" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="VisualToolClip" Classes="visualTool" IsChecked="{Binding Actions[video/tool/clip].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/tool/clip]}" ToolTip.Tip="Rectangular clip" AutomationProperties.Name="Rectangular clip"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Clip" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="VisualToolVectorClip" Classes="visualTool" IsChecked="{Binding Actions[video/tool/vectorclip].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/tool/vectorclip]}" ToolTip.Tip="Vector clip" AutomationProperties.Name="Vector clip"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Vector" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <Button Name="VisualMotionTrack" Classes="visualTool" Command="{Binding Actions[video/motion-track]}" ToolTip.Tip="Motion track" AutomationProperties.Name="Motion track"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Track" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></Button>
        <ToggleButton Name="VisualToolDistort" Classes="visualTool" IsChecked="{Binding Actions[video/tool/distort].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/tool/distort]}" ToolTip.Tip="Distort" AutomationProperties.Name="Distort"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Distort" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="VisualToolDrawing" Classes="visualTool" IsChecked="{Binding Actions[video/tool/drawing].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/tool/drawing]}" ToolTip.Tip="Draw ASS shapes directly on video" AutomationProperties.Name="Draw ASS shapes directly on video"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Drawing" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="VisualToolShear" Classes="visualTool" IsChecked="{Binding Actions[video/tool/shear].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/tool/shear]}" ToolTip.Tip="Shear" AutomationProperties.Name="Shear"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Shear" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="VisualToolShift" Classes="visualTool" IsChecked="{Binding Actions[video/tool/shift].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/tool/shift]}" ToolTip.Tip="Shift position, origin and clip" AutomationProperties.Name="Shift position, origin and clip"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Shift" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="VisualToolTags" Classes="visualTool" IsChecked="{Binding Actions[video/tool/tags].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/tool/tags]}" ToolTip.Tip="Numeric tags" AutomationProperties.Name="Numeric tags"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Tags" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        </WrapPanel>
        <WrapPanel Name="VisualContextTools" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" IsVisible="{Binding IsPositionTool}" Margin="0,0,2,0" Spacing="1" VerticalAlignment="Center"><ComboBox ItemsSource="{Binding PositionModes}" SelectedItem="{Binding PositionMode, Mode=TwoWay}" Width="112" Padding="4,1" ToolTip.Tip="Choose how to set position, movement endpoints or rotation origin" /><Button Name="MoveToggle" Classes="visualTool" Command="{Binding Actions[video/position/toggle-move]}" ToolTip.Tip="Toggle position / movement" AutomationProperties.Name="Toggle position / movement"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="MoveToggle" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></Button></StackPanel>
      <ComboBox IsVisible="{Binding IsRotateZTool}" ItemsSource="{Binding RotateZModes}" SelectedItem="{Binding RotateZMode, Mode=TwoWay}" Width="114" Padding="4,1" ToolTip.Tip="Rotate with the angle ring or a guide drawn along the video" />
      <ComboBox IsVisible="{Binding IsScaleTool}" ItemsSource="{Binding ScaleModes}" SelectedItem="{Binding ScaleMode, Mode=TwoWay}" Width="126" Padding="4,1" ToolTip.Tip="Choose a scale axis, lock proportions or fit a rectangle" />
      <ComboBox IsVisible="{Binding IsShiftTool}" ItemsSource="{Binding ShiftModes}" SelectedItem="{Binding ShiftMode, Mode=TwoWay}" Width="125" Padding="4,1" ToolTip.Tip="Choose which geometry to translate" />
        <WrapPanel Name="VectorSubtoolbar" Orientation="Horizontal" IsVisible="{Binding IsVectorClipTool}">
        <ToggleButton Name="VectorSelect" Classes="visualTool" IsChecked="{Binding Actions[video/vector/select].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/vector/select]}" ToolTip.Tip="Select and move points" AutomationProperties.Name="Select and move points"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Select" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="VectorLine" Classes="visualTool" IsChecked="{Binding Actions[video/vector/line].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/vector/line]}" ToolTip.Tip="Place straight-line endpoints" AutomationProperties.Name="Place straight-line endpoints"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Line" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="VectorBicubic" Classes="visualTool" IsChecked="{Binding Actions[video/vector/bicubic].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/vector/bicubic]}" ToolTip.Tip="Place Bézier segments" AutomationProperties.Name="Place Bézier segments"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Bicubic" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="VectorConvert" Classes="visualTool" IsChecked="{Binding Actions[video/vector/convert].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/vector/convert]}" ToolTip.Tip="Convert straight / curved segment" AutomationProperties.Name="Convert straight / curved segment"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Convert" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="VectorInsert" Classes="visualTool" IsChecked="{Binding Actions[video/vector/insert].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/vector/insert]}" ToolTip.Tip="Insert point" AutomationProperties.Name="Insert point"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Insert" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="VectorRemove" Classes="visualTool" IsChecked="{Binding Actions[video/vector/remove].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/vector/remove]}" ToolTip.Tip="Remove point" AutomationProperties.Name="Remove point"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Remove" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolWarningBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="VectorFreehand" Classes="visualTool" IsChecked="{Binding Actions[video/vector/freehand].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/vector/freehand]}" ToolTip.Tip="Freehand drawing" AutomationProperties.Name="Freehand drawing"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Freehand" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="VectorSmooth" Classes="visualTool" IsChecked="{Binding Actions[video/vector/smooth].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/vector/smooth]}" ToolTip.Tip="Smooth freehand" AutomationProperties.Name="Smooth freehand"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Smooth" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        </WrapPanel>
        <ToggleButton Name="NewInverseClip" Classes="visualTool" IsVisible="{Binding IsClipFamily}" IsChecked="{Binding InverseClip, Mode=TwoWay}" ToolTip.Tip="Create inverse clip" AutomationProperties.Name="Create inverse clip"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Inverse" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolWarningBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <Button Name="InvertClip" Classes="visualTool" IsVisible="{Binding IsClipFamily}" Command="{Binding Actions[video/clip/invert]}" ToolTip.Tip="Invert existing clip" AutomationProperties.Name="Invert existing clip"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Invert" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolWarningBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></Button>
        <Button Name="DrawingNewEvent" Classes="visualTool" IsVisible="{Binding IsDrawingTool}" Command="{Binding Actions[video/drawing/new]}" ToolTip.Tip="New drawing event at current video frame" AutomationProperties.Name="New drawing event at current video frame"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="NewDrawing" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></Button>
        <ToggleButton Name="DrawingSelect" Classes="visualTool" IsVisible="{Binding IsDrawingTool}" IsChecked="{Binding Actions[video/drawing/select].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/drawing/select]}" ToolTip.Tip="Select and move points" AutomationProperties.Name="Select and move points"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Select" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="DrawingLine" Classes="visualTool" IsVisible="{Binding IsDrawingTool}" IsChecked="{Binding Actions[video/drawing/line].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/drawing/line]}" ToolTip.Tip="Place straight-line endpoints" AutomationProperties.Name="Place straight-line endpoints"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Line" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="DrawingBicubic" Classes="visualTool" IsVisible="{Binding IsDrawingTool}" IsChecked="{Binding Actions[video/drawing/bicubic].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/drawing/bicubic]}" ToolTip.Tip="Place Bézier segments" AutomationProperties.Name="Place Bézier segments"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Bicubic" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="DrawingSpline" Classes="visualTool" IsVisible="{Binding IsDrawingTool}" IsChecked="{Binding Actions[video/drawing/spline].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/drawing/spline]}" ToolTip.Tip="Draw a smooth spline" AutomationProperties.Name="Draw a smooth spline"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Spline" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="DrawingContour" Classes="visualTool" IsVisible="{Binding IsDrawingTool}" IsChecked="{Binding Actions[video/drawing/contour].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/drawing/contour]}" ToolTip.Tip="Start a new contour" AutomationProperties.Name="Start a new contour"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Contour" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="DrawingConvert" Classes="visualTool" IsVisible="{Binding IsDrawingTool}" IsChecked="{Binding Actions[video/drawing/convert].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/drawing/convert]}" ToolTip.Tip="Convert straight / curved segment" AutomationProperties.Name="Convert straight / curved segment"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Convert" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="DrawingInsert" Classes="visualTool" IsVisible="{Binding IsDrawingTool}" IsChecked="{Binding Actions[video/drawing/insert].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/drawing/insert]}" ToolTip.Tip="Insert point" AutomationProperties.Name="Insert point"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Insert" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="DrawingRemove" Classes="visualTool" IsVisible="{Binding IsDrawingTool}" IsChecked="{Binding Actions[video/drawing/remove].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/drawing/remove]}" ToolTip.Tip="Remove point" AutomationProperties.Name="Remove point"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Remove" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolWarningBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="DrawingFreehand" Classes="visualTool" IsVisible="{Binding IsDrawingTool}" IsChecked="{Binding Actions[video/drawing/freehand].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/drawing/freehand]}" ToolTip.Tip="Freehand drawing" AutomationProperties.Name="Freehand drawing"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Freehand" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="DrawingSmooth" Classes="visualTool" IsVisible="{Binding IsDrawingTool}" IsChecked="{Binding Actions[video/drawing/smooth].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/drawing/smooth]}" ToolTip.Tip="Smooth freehand" AutomationProperties.Name="Smooth freehand"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Smooth" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="DrawingMove" Classes="visualTool" IsVisible="{Binding IsDrawingTool}" IsChecked="{Binding Actions[video/drawing/move].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/drawing/move]}" ToolTip.Tip="Move the entire drawing" AutomationProperties.Name="Move the entire drawing"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Position" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="DrawingResize" Classes="visualTool" IsVisible="{Binding IsDrawingTool}" IsChecked="{Binding Actions[video/drawing/resize].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/drawing/resize]}" ToolTip.Tip="Resize the drawing" AutomationProperties.Name="Resize the drawing"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Scale" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ToggleButton Name="DrawingRotate" Classes="visualTool" IsVisible="{Binding IsDrawingTool}" IsChecked="{Binding Actions[video/drawing/rotate].IsChecked, Mode=OneWay}" Command="{Binding Actions[video/drawing/rotate]}" ToolTip.Tip="Rotate the drawing" AutomationProperties.Name="Rotate the drawing"><controls:VisualToolbarGlyph Width="20" Height="20" Glyph="Rotate" Accent="{DynamicResource VisualToolPrimaryBrush}" Detail="{DynamicResource VisualToolDetailBrush}" Outline="{DynamicResource AppBackgroundBrush}" /></ToggleButton>
        <ComboBox Name="DrawingPresetPicker" IsVisible="{Binding IsDrawingTool}" ItemsSource="{Binding DrawingPresets}" SelectedItem="{Binding DrawingPreset, Mode=TwoWay}" Width="104" MinHeight="24" Padding="2,0" ToolTip.Tip="Select a shape and drag it onto the video" AutomationProperties.Name="Drawing shape preset" />
      <StackPanel Orientation="Horizontal" IsVisible="{Binding IsTagsTool}" Spacing="4">
        <ComboBox ItemsSource="{Binding VisualNumericTags}" SelectedItem="{Binding VisualNumericTag, Mode=TwoWay}" Width="105" Padding="4,1" ToolTip.Tip="Choose the numeric ASS tag to change" />
        <ComboBox ItemsSource="{Binding VisualTagOperations}" SelectedItem="{Binding VisualTagOperation, Mode=TwoWay}" Width="105" Padding="4,1" ToolTip.Tip="Adjust, set, or distribute a value across visible selected lines" />
      </StackPanel>
        </WrapPanel>
      </controls:VisualToolbarLayout>
    </Border>
      </Grid>
    </Border>

  </Grid>
  <GridSplitter Name="VideoSplitter" Grid.Column="1" IsVisible="{Binding ShowEmbeddedVideo}" ResizeDirection="Columns" Background="{DynamicResource SplitterBrush}" />
  <Grid Grid.Column="2" Name="TemporalTextColumn">
    <Grid.RowDefinitions><RowDefinition Height="180" MinHeight="160" /><RowDefinition Height="4" /><RowDefinition Height="*" MinHeight="280" /></Grid.RowDefinitions>
    <Border Grid.Row="0" IsVisible="{Binding ShowAudio}" Background="{DynamicResource PanelBrush}">
      <Grid Name="AudioHost" RowDefinitions="*,Auto">
      <Grid Name="AudioRegion" Margin="3,3,3,2" RowDefinitions="*,14,Auto" RowSpacing="1">
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="3" MinHeight="30"><ScrollViewer Name="AudioActionScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Spacing="2">
<Button Command="{Binding Actions[audio/zoom/out]}" Padding="3,1" ToolTip.Tip="Zoom audio out"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.ZoomOut}" /></Button><Button Command="{Binding Actions[audio/zoom/in]}" Padding="3,1" ToolTip.Tip="Zoom audio in"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.ZoomIn}" /></Button><Button Command="{Binding Actions[time/prev]}" Padding="3,1" ToolTip.Tip="Previous timing line"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.TimingPrevious}" /></Button>
<Button Command="{Binding Actions[time/next]}" Padding="3,1" ToolTip.Tip="Next timing line"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.TimingNext}" /></Button>
<Button Command="{Binding Actions[audio/play/selection]}" Padding="3,1" ToolTip.Tip="Play selection"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.AudioPlaySelection}" Foreground="{DynamicResource IconAudioSelectionBrush}" /></Button>
<Button Command="{Binding Actions[audio/play/line]}" Padding="3,1" ToolTip.Tip="Play current line"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.AudioPlayLine}" Foreground="{DynamicResource IconAudioLineBrush}" /></Button>
<Button Command="{Binding Actions[audio/stop]}" Padding="3,1" ToolTip.Tip="Stop playback"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Stop}" /></Button>
<Button Command="{Binding Actions[audio/play/selection/before]}" Padding="3,1" ToolTip.Tip="Play 500 ms before selection"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.AudioPlayBefore}" /></Button>
<Button Command="{Binding Actions[audio/play/selection/after]}" Padding="3,1" ToolTip.Tip="Play 500 ms after selection"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.AudioPlayAfter}" /></Button>
<Button Command="{Binding Actions[audio/play/selection/begin]}" Padding="3,1" ToolTip.Tip="Play first 500 ms"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.AudioPlayBegin}" /></Button>
<Button Command="{Binding Actions[audio/play/selection/end]}" Padding="3,1" ToolTip.Tip="Play last 500 ms"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.AudioPlayEnd}" /></Button>
<Button Command="{Binding Actions[audio/play/to_end]}" Padding="3,1" ToolTip.Tip="Play selection to end of audio"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.AudioPlayToEnd}" /></Button>
<Button Command="{Binding Actions[time/lead/in]}" Padding="3,1" ToolTip.Tip="Add lead-in"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.LeadIn}" /></Button>
<Button Command="{Binding Actions[time/lead/out]}" Padding="3,1" ToolTip.Tip="Add lead-out"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.LeadOut}" /></Button>
<Button Command="{Binding Actions[audio/commit]}" Padding="3,1" ToolTip.Tip="Commit timing"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.AudioCommit}" /></Button>
<Button Command="{Binding Actions[audio/go_to]}" Padding="3,1" ToolTip.Tip="Go to selection"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.AudioGoTo}" /></Button>
<ToggleButton Classes="authoring" IsChecked="{Binding Actions[audio/opt/autocommit].IsChecked, Mode=OneWay}" Command="{Binding Actions[audio/opt/autocommit]}" Padding="3,1" ToolTip.Tip="Auto-commit timing"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.AudioAutocommit}" /></ToggleButton>
<ToggleButton Classes="authoring" IsChecked="{Binding Actions[audio/opt/autonext].IsChecked, Mode=OneWay}" Command="{Binding Actions[audio/opt/autonext]}" Padding="3,1" ToolTip.Tip="Next line on commit"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.AudioAutonext}" /></ToggleButton>
<ToggleButton Classes="authoring" IsChecked="{Binding Actions[audio/opt/autoscroll].IsChecked, Mode=OneWay}" Command="{Binding Actions[audio/opt/autoscroll]}" Padding="3,1" ToolTip.Tip="Autoscroll audio"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.AudioAutoscroll}" /></ToggleButton>
<ToggleButton Classes="authoring" IsChecked="{Binding Actions[audio/opt/spectrum].IsChecked, Mode=OneWay}" Command="{Binding Actions[audio/opt/spectrum]}" Padding="3,1" ToolTip.Tip="Spectrum analyzer"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.AudioSpectrum}" /></ToggleButton>
<ToggleButton Classes="authoring" Name="KaraokeToggle" IsChecked="{Binding Actions[audio/karaoke].IsChecked, Mode=OneWay}" Command="{Binding Actions[audio/karaoke]}" Padding="3,1" ToolTip.Tip="Toshiki K-Timing"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.KaraokeTiming}" /></ToggleButton>
<ToggleButton Classes="authoring" Content="Mute" IsChecked="{Binding PlaybackMuted, Mode=TwoWay}" Padding="3,0" ToolTip.Tip="Mute editor playback" />
<ComboBox Name="AudioMode" Margin="4,0,0,0" SelectedIndex="{Binding AudioDisplayModeIndex, Mode=TwoWay}" Padding="5,0"><ComboBoxItem Content="Waveform" /><ComboBoxItem Content="Spectrogram" /></ComboBox>
</StackPanel></ScrollViewer><TextBlock Grid.Column="1" MaxWidth="100" Name="AudioStatus" Text="{Binding MediaStatus}" ToolTip.Tip="{Binding MediaStatus}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="{DynamicResource YoakeUiFontSizeTiny}" /></Grid>
        <controls:AudioWaveformControl Grid.Row="0" Margin="0,0,84,0" Name="AudioDisplay" ToolTip.Tip="Click: seek · Orange/blue: drag start/end · Shift+drag inside line: move timing · Wheel: pan · Ctrl+wheel: zoom · Shift+wheel: amplitude" Model="{Binding}" Samples="{Binding WaveformSamples}" Stroke="{DynamicResource IconAccentBrush}" />
        <Border Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" Width="1" Margin="0,0,82,0" Background="{DynamicResource DividerBrush}" />
        <Grid Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" ColumnDefinitions="24,24,24" RowDefinitions="*,18" ColumnSpacing="2" RowSpacing="2" Margin="0,5,3,0">
          <Slider Grid.Row="0" Grid.Column="0" Name="AudioHorizontalZoom" Theme="{StaticResource AudioVerticalSlider}" AutomationProperties.Name="Horizontal audio zoom" Orientation="Vertical" Minimum="0" Maximum="100" Value="{Binding AudioHorizontalZoom, Mode=TwoWay}" ToolTip.Tip="Horizontal zoom · time per pixel" />
          <Slider Grid.Row="0" Grid.Column="1" Name="AudioIntensity" Theme="{StaticResource AudioVerticalSlider}" AutomationProperties.Name="Display amplitude" Orientation="Vertical" Minimum="10" Maximum="100" Value="{Binding AudioAmplitude, Mode=TwoWay}" ToolTip.Tip="Display amplitude / spectral intensity (independent of volume)" />
          <Slider Grid.Row="0" Grid.Column="2" Name="AudioVolume" Theme="{StaticResource AudioVerticalSlider}" AutomationProperties.Name="Playback volume" IsEnabled="{Binding IsVolumeIndependent}" Orientation="Vertical" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding PlaybackVolume, Mode=TwoWay}" ToolTip.Tip="Playback volume · 0–100%" />
          <ToggleButton Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Name="AudioVolumeLink" Classes="audioLink" HorizontalAlignment="Stretch" MinWidth="0" Height="16" MinHeight="16" Padding="0" HorizontalContentAlignment="Center" AutomationProperties.Name="Link amplitude and volume" IsChecked="{Binding Actions[audio/opt/vertical_link].IsChecked, Mode=OneWay}" Command="{Binding Actions[audio/opt/vertical_link]}" ToolTip.Tip="Link display amplitude to playback level"><PathIcon Width="15" Height="12" Data="{x:Static icons:IconGeometries.AudioLink}" Foreground="{DynamicResource IconForegroundBrush}" /></ToggleButton>
        </Grid>
        <ScrollBar Grid.Row="1" Name="AudioPanner" Orientation="Horizontal" Minimum="0" Maximum="{Binding #AudioDisplay.MaximumPan}" ViewportSize="{Binding #AudioDisplay.VisibleSeconds}" Value="{Binding #AudioDisplay.ViewportStart, Mode=TwoWay}" SmallChange="0.5" LargeChange="5" Margin="0,0,84,0" ToolTip.Tip="Pan the visible audio time range" />
      </Grid>
      <controls:KaraokeSlotsControl Grid.Row="1" Name="KaraokeSlots" Model="{Binding}" IsVisible="{Binding ShowKaraoke}" Margin="6,0,6,4" />
      </Grid>
    </Border>
    <GridSplitter Name="AudioSplitter" Grid.Row="1" IsVisible="{Binding ShowAudio}" ResizeDirection="Rows" Background="{DynamicResource SplitterBrush}" />
    <Border Grid.Row="2" Background="{DynamicResource PanelBrush}">
      <Grid Name="EventEditorRegion" Margin="3" RowDefinitions="Auto,*,Auto" RowSpacing="2" IsEnabled="{Binding HasSelectedEvent}">
        <Grid.Styles>
          <Style Selector="TextBox"><Setter Property="MinHeight" Value="24" /><Setter Property="FontSize" Value="{DynamicResource YoakeUiFontSize}" /></Style>
          <Style Selector="ComboBox"><Setter Property="MinHeight" Value="24" /><Setter Property="FontSize" Value="{DynamicResource YoakeUiFontSize}" /></Style>
          <Style Selector="NumericUpDown"><Setter Property="MinHeight" Value="24" /><Setter Property="FontSize" Value="{DynamicResource YoakeUiFontSize}" /></Style>
          <Style Selector="Button"><Setter Property="MinHeight" Value="24" /></Style>
        </Grid.Styles>
        <WrapPanel Grid.Row="0" Name="FormattingToolbar" Margin="0">
          <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,0,5,0">
            <ToggleButton Classes="authoring" IsThreeState="True" IsChecked="{Binding Formatting.Bold, Mode=OneWay}" Command="{Binding Actions[text/format/bold]}" ToolTip.Tip="{Binding Actions[text/format/bold].Tooltip}"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.FormatBold}" /></ToggleButton>
            <ToggleButton Classes="authoring" IsThreeState="True" IsChecked="{Binding Formatting.Italic, Mode=OneWay}" Command="{Binding Actions[text/format/italic]}" ToolTip.Tip="{Binding Actions[text/format/italic].Tooltip}"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.FormatItalic}" /></ToggleButton>
            <ToggleButton Classes="authoring" IsThreeState="True" IsChecked="{Binding Formatting.Underline, Mode=OneWay}" Command="{Binding Actions[text/format/underline]}" ToolTip.Tip="{Binding Actions[text/format/underline].Tooltip}"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.FormatUnderline}" /></ToggleButton>
            <ToggleButton Classes="authoring" IsThreeState="True" IsChecked="{Binding Formatting.Strikeout, Mode=OneWay}" Command="{Binding Actions[text/format/strikeout]}" ToolTip.Tip="Strikeout"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.FormatStrikeout}" /></ToggleButton>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,5,0">
            <Button Name="SubtitleFontButton" Command="{Binding Actions[text/format/font]}" Padding="5,0" ToolTip.Tip="Font family and size for selection"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.FormatFont}" /></Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,0,5,0">
            <controls:AssColorButton Value="{Binding Formatting.Primary}" Label="1" Command="{Binding Actions[text/format/primary]}" ToolTip.Tip="Primary color and alpha at caret (static state)" />
            <controls:AssColorButton Value="{Binding Formatting.Secondary}" Label="2" Command="{Binding Actions[text/format/secondary]}" ToolTip.Tip="Secondary karaoke color and alpha at caret (static state)" />
            <controls:AssColorButton Value="{Binding Formatting.Outline}" Label="3" Command="{Binding Actions[text/format/outline]}" ToolTip.Tip="Outline color and alpha at caret (static state)" />
            <controls:AssColorButton Value="{Binding Formatting.Shadow}" Label="4" Command="{Binding Actions[text/format/shadow]}" ToolTip.Tip="Shadow color and alpha at caret (static state)" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,0,4,0">
            <Button Name="JapaneseBracketsButton" IsEnabled="{Binding HasSelectedEvent}" Content="『』" Padding="5,0" ToolTip.Tip="Insert paired Japanese brackets around the selection or at the caret" />
            <Button Name="FuriganaButton" Content="Furigana…" Padding="5,0" Command="{Binding Actions[text/insert/furigana]}" ToolTip.Tip="Add reading and opposite-side reading to selected base text (Mangetsu)" />
            <Button Content="Reset" Command="{Binding Actions[text/format/reset]}" Padding="5,0" FontSize="{DynamicResource YoakeUiFontSizeSmall}" ToolTip.Tip="Reset to line style at caret / selection" />
          </StackPanel>
          <RadioButton Name="TimingByTime" GroupName="EditorTimingUnit" Content="Time" IsChecked="{Binding !TimingByFrames, Mode=OneWay}" Click="TimingUnitClick" FontSize="{DynamicResource YoakeUiFontSizeSmall}" Margin="4,0" />
          <RadioButton Name="TimingByFrame" GroupName="EditorTimingUnit" Content="Frame" IsChecked="{Binding TimingByFrames, Mode=OneWay}" IsEnabled="{Binding CanShiftByFrames}" Click="TimingUnitClick" FontSize="{DynamicResource YoakeUiFontSizeSmall}" Margin="4,0" />
          <CheckBox Name="ShowOriginalToggle" Content="Show Original" IsChecked="{Binding ShowOriginal, Mode=OneWay}" Command="{Binding Actions[edit/show_original]}" Height="24" MinHeight="24" FontSize="{DynamicResource YoakeUiFontSizeSmall}" Margin="4,0,0,0" />
          <CheckBox Name="BetterViewToggle" Content="Better View" IsChecked="{Binding Actions[edit/better-view].IsChecked, Mode=OneWay}" Command="{Binding Actions[edit/better-view]}" Height="24" MinHeight="24" FontSize="{DynamicResource YoakeUiFontSizeSmall}" Margin="4,0,0,0" ToolTip.Tip="Show hard line breaks and compact motion data" />
        </WrapPanel>

        <Grid Grid.Row="1" Name="SubtitleTextEditors" ColumnDefinitions="*,0,0">
          <controls:AssTextBox Name="SubtitleText" Grid.Column="0" Watermark="Subtitle text" ToolTip.Tip="Edit ASS text · Shift+Enter inserts a hard line break" FontSize="{DynamicResource YoakeUiEditorFontSize}" SourceText="{Binding EventEditorText, Mode=TwoWay}" IsReadOnly="{Binding IsDrawingGesture}" BetterView="{Binding BetterView}" ShowMotionData="{Binding ShowMotionData}" MotionToggleCommand="{Binding Actions[edit/motion-block/toggle]}" MotionCopyCommand="{Binding Actions[edit/motion-block/copy]}" AcceptsReturn="True" ClearSelectionOnLostFocus="False" TextWrapping="Wrap" VerticalContentAlignment="Top" MinHeight="64" />
          <StackPanel Name="OriginalActions" Grid.Column="1" IsVisible="{Binding ShowOriginal}" Orientation="Vertical" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Name="OriginalInsert" Command="{Binding Actions[edit/insert_original]}" Width="28" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Insert original into translation" AutomationProperties.Name="Insert Original">
              <PathIcon Width="16" Height="16" Data="M2,12 L11,3 L13,5 L7,11 H23 V13 H7 L13,19 L11,21 Z" Foreground="{DynamicResource VisualToolPrimaryBrush}" />
            </Button>
            <Button Name="OriginalRevert" Command="{Binding Actions[edit/revert]}" Width="28" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Revert translation to original" AutomationProperties.Name="Revert to Original">
              <PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Undo}" Foreground="{DynamicResource VisualToolPrimaryBrush}" />
            </Button>
            <Button Name="OriginalClearText" Command="{Binding Actions[edit/clear/text]}" Width="28" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Clear visible text; keep ASS tags and drawings" AutomationProperties.Name="Clear Text">
              <Grid Width="18" Height="18" IsHitTestVisible="False">
                <PathIcon Name="OriginalClearTextGlyph" Width="13" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M1,1 H15 V4 H9.5 V18 H6.5 V4 H1 Z" Foreground="{DynamicResource VisualToolPrimaryBrush}" />
                <PathIcon Name="OriginalClearTextCross" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="{x:Static icons:IconGeometries.Close}" Foreground="{DynamicResource VisualToolWarningBrush}" />
              </Grid>
            </Button>
            <Button Name="OriginalClear" Command="{Binding Actions[edit/clear]}" Width="28" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Clear entire translation, including tags" AutomationProperties.Name="Clear All">
              <PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Delete}" Foreground="{DynamicResource VisualToolWarningBrush}" />
            </Button>
            <Button Name="OriginalJoinLast" Command="{Binding Actions[edit/line/join/last]}" Width="28" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Join previous line into current translation" AutomationProperties.Name="Join Last">
              <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24" IsHitTestVisible="False">
                <Path Data="M2,15 H12 V17 H2 Z M2,19 H12 V21 H2 Z" Fill="{DynamicResource VisualToolDetailBrush}" />
                <Path Data="M2,3 H12 V5 H2 Z M2,7 H12 V9 H2 Z M15,5 H18 V16 H14 L19,22 L24,16 H21 V2 H15 Z" Fill="{DynamicResource VisualToolPrimaryBrush}" />
              </Canvas></Viewbox>
            </Button>
            <Button Name="OriginalJoinNext" Command="{Binding Actions[edit/line/join/next/translatormode]}" Width="28" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Join next line timing and original text; keep translation" AutomationProperties.Name="Join Next">
              <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24" IsHitTestVisible="False">
                <Path Data="M2,3 H12 V5 H2 Z M2,7 H12 V9 H2 Z" Fill="{DynamicResource VisualToolDetailBrush}" />
                <Path Data="M2,15 H12 V17 H2 Z M2,19 H12 V21 H2 Z M15,19 H18 V8 H14 L19,2 L24,8 H21 V22 H15 Z" Fill="{DynamicResource VisualToolPrimaryBrush}" />
              </Canvas></Viewbox>
            </Button>
          </StackPanel>
          <controls:AssTextBox Name="OriginalText" Grid.Column="2" IsVisible="{Binding ShowOriginal}" SourceText="{Binding OriginalText, Mode=OneWay}" BetterView="{Binding BetterView}" ShowMotionData="True" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" FontSize="{DynamicResource YoakeUiEditorFontSize}" VerticalContentAlignment="Top" Watermark="Original" ToolTip.Tip="Original text captured when this line became active" />
        </Grid>

        <!-- Single property strip at desktop widths; wrap only when the window is genuinely narrow. -->
        <WrapPanel Grid.Row="2" Name="MetadataFields" VerticalAlignment="Center">
          <WrapPanel.Styles>
            <Style Selector="NumericUpDown"><Setter Property="MinWidth" Value="0" /></Style>
          </WrapPanel.Styles>
          <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,3,0">
            <ToggleButton Name="LineCommentToggle" VerticalAlignment="Center" Width="28" MinWidth="0" MinHeight="{DynamicResource YoakeUiRowHeight}" Padding="3,0"
                          IsChecked="{Binding SelectedIsComment, Mode=OneWay}" Command="{Binding Actions[edit/comment]}" CommandParameter="{Binding $self.IsChecked}"
                          AutomationProperties.Name="Comment / hide subtitle line" ToolTip.Tip="Toggle comment: open eye = dialogue, crossed eye = comment">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24" IsHitTestVisible="False">
                  <Path Name="DialogueEye" IsVisible="{Binding !SelectedIsComment}" Data="M2 12 C7 3 17 3 22 12 C17 21 7 21 2 12 Z M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9" Stroke="{DynamicResource IconForegroundBrush}" StrokeThickness="1.7" StrokeJoin="Round" />
                  <Path Name="CommentEye" IsVisible="{Binding SelectedIsComment}" Data="M2 12 C3.6 9.1 5.8 7.2 8.2 6.3 M12.5 5.5 C16.3 5.5 19.7 7.8 22 12 C20.9 14 19.6 15.6 18 16.7 M14.5 18 C9.3 19.5 4.5 16.5 2 12 M10 10 A3 3 0 0 0 14 14" Stroke="{DynamicResource IconForegroundBrush}" StrokeThickness="1.7" StrokeLineCap="Round" />
                  <Path Name="CommentEyeSlash" IsVisible="{Binding SelectedIsComment}" Data="M3 3 L21 21" Stroke="{DynamicResource VisualToolPrimaryBrush}" StrokeThickness="2.2" StrokeLineCap="Round" />
                </Canvas>
              </Viewbox>
            </ToggleButton>
            <!-- Layers are signed integers; each spinner step is exactly one. -->
            <NumericUpDown Name="LineLayer" Width="52" MinWidth="0" Text="{Binding EditorDraft.Layer, Mode=TwoWay}" Minimum="-2147483648" Maximum="2147483647" Increment="1" FormatString="0" Padding="2,0" ToolTip.Tip="Layer (signed integer; arrows change by one)" AutomationProperties.Name="Layer" />
          </StackPanel>

          <Grid Name="LineTimingGroup" ColumnSpacing="2" Margin="0,0,3,0">
<Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource YoakeUiTimeFieldWidth}" /><ColumnDefinition Width="{DynamicResource YoakeUiTimeFieldWidth}" /><ColumnDefinition Width="{DynamicResource YoakeUiDurationFieldWidth}" /></Grid.ColumnDefinitions>
<TextBox Name="LineStart" Grid.Column="0" Text="{Binding EditorDraft.TimingStart, Mode=TwoWay}" Padding="3,0" ToolTip.Tip="Start time or first frame" />
<TextBox Name="LineEnd" Grid.Column="1" Text="{Binding EditorDraft.TimingEnd, Mode=TwoWay}" Padding="3,0" ToolTip.Tip="End time or last frame" />
<TextBox Name="LineDuration" Grid.Column="2" Text="{Binding EditorDraft.TimingDuration, Mode=TwoWay}" Padding="3,0" ToolTip.Tip="Duration in time or inclusive frame count" />
</Grid>
<Grid Name="StyleControls" Width="145" ColumnDefinitions="*,24" ColumnSpacing="2" Margin="0,0,3,0">
<ComboBox Name="LineStyle" VerticalAlignment="Center" ItemsSource="{Binding StyleNames}" SelectedItem="{Binding EditorDraft.Style, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="3,0" ToolTip.Tip="Style" MinHeight="{DynamicResource YoakeUiRowHeight}" />
<Button Grid.Column="1" Command="{Binding Actions[styles/manage]}" Padding="3,0" ToolTip.Tip="Edit selected style in Styles Manager" MinHeight="{DynamicResource YoakeUiRowHeight}"><PathIcon Width="14" Height="14" Data="{x:Static icons:IconGeometries.StylesManager}" /></Button>
</Grid>
          <Grid Name="MetadataOtherFields" Width="146" ColumnDefinitions="*,24" ColumnSpacing="2" Margin="0,0,3,0">
            <AutoCompleteBox Name="LineActor" VerticalAlignment="Center" ItemsSource="{Binding ActorNames}" Text="{Binding EditorDraft.Actor, Mode=TwoWay}" MinimumPrefixLength="1" Padding="3,0" PlaceholderText="Actor" ToolTip.Tip="Actor / Name" MinHeight="{DynamicResource YoakeUiRowHeight}" />
            <ToggleButton Name="FastActorToggle" Grid.Column="1" Padding="2,0" Content="»" IsChecked="{Binding Actions[actor/fast/toggle].IsChecked, Mode=OneWay}" Command="{Binding Actions[actor/fast/toggle]}" ToolTip.Tip="Fast actor naming" MinHeight="{DynamicResource YoakeUiRowHeight}" />
            <Popup Name="FastActorPopup" PlacementTarget="{Binding #LineActor}" Placement="Bottom" IsLightDismissEnabled="False">
              <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Padding="5" MinWidth="180">
                <StackPanel Spacing="3"><TextBlock Text="Recent actors" FontSize="{DynamicResource YoakeUiFontSizeSmall}" /><ListBox Name="FastActorList" MaxHeight="240" ItemsSource="{Binding FastActorRecent}" SelectedIndex="{Binding FastActorSelectedIndex, Mode=OneWay}" /><TextBlock Text="Fast naming mode" FontSize="{DynamicResource YoakeUiFontSizeSmall}" /><ComboBox Name="FastActorMode" SelectedItem="{Binding FastActorMode, Mode=OneWay}" ToolTip.Tip="Nanashi: tap Ctrl for next line, Alt for previous line" /><TextBlock Text="After advancing, play" FontSize="{DynamicResource YoakeUiFontSizeSmall}" /><ComboBox Name="FastActorPlayback" SelectedItem="{Binding FastActorPlayback, Mode=OneWay}" /></StackPanel>
              </Border>
            </Popup>
</Grid>

            <Grid Name="LineMarginGroup" ColumnDefinitions="52,52,52" ColumnSpacing="2" Margin="0,0,3,0">
<NumericUpDown Name="MarginLeft" Grid.Column="0" MinWidth="0" Text="{Binding EditorDraft.MarginL, Mode=TwoWay}" Minimum="0" Maximum="2147483647" Increment="1" FormatString="0" ToolTip.Tip="Left margin (script pixels)" />
<NumericUpDown Name="MarginRight" Grid.Column="1" MinWidth="0" Text="{Binding EditorDraft.MarginR, Mode=TwoWay}" Minimum="0" Maximum="2147483647" Increment="1" FormatString="0" ToolTip.Tip="Right margin (script pixels)" />
<NumericUpDown Name="MarginVertical" Grid.Column="2" MinWidth="0" Text="{Binding EditorDraft.MarginV, Mode=TwoWay}" Minimum="0" Maximum="2147483647" Increment="1" FormatString="0" ToolTip.Tip="Vertical margin (script pixels)" />
</Grid>
<TextBox Name="LineEffect" Width="102" Text="{Binding EditorDraft.Effect, Mode=TwoWay}" Padding="3,0" PlaceholderText="Effect" MinHeight="{DynamicResource YoakeUiRowHeight}" />
        </WrapPanel>
      </Grid>
    </Border>
  </Grid>
</Grid>
<GridSplitter Name="WorkspaceSplitter" Grid.Row="3" ResizeDirection="Rows" Background="{DynamicResource SplitterBrush}" />
<Border Grid.Row="4" Margin="6" Name="SubtitleGridRegion" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
<Grid ToolTip.Tip="SUBTITLE GRID"><Grid.RowDefinitions><RowDefinition Height="{DynamicResource YoakeUiGridHeaderHeight}" /><RowDefinition Height="*" /></Grid.RowDefinitions>
<Border Padding="6,2" Background="{DynamicResource SubtitleGridHeaderBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"><Grid Name="ColumnHeader" PointerPressed="HeaderPressed" PointerMoved="HeaderMoved" PointerReleased="HeaderReleased" ColumnDefinitions="32,32,84,84,64,64,64,40,40,40,*" ToolTip.Tip="Drag a column boundary to resize"><TextBlock Grid.Column="0" Text="#" Margin="4,0" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="L" Margin="4,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="Layer" /><TextBlock Grid.Column="2" Text="Start" Margin="4,0" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" Text="End" Margin="4,0" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="4" Text="Style" Margin="4,0" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="5" Text="Actor" Margin="4,0" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="6" Text="Effect" Margin="4,0" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="7" Text="ML" Margin="4,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="Left margin" /><TextBlock Grid.Column="8" Text="MR" Margin="4,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="Right margin" /><TextBlock Grid.Column="9" Text="MV" Margin="4,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="Vertical margin" /><TextBlock Grid.Column="10" Text="Text" Margin="4,0" TextTrimming="CharacterEllipsis" /></Grid></Border>
<ListBox Name="SubtitleRows" controls:SubtitleGridText.TagDisplayMode="{Binding GridTagDisplay}" Grid.Row="1" ItemsSource="{Binding Events}" SelectionMode="Multiple" AutoScrollToSelectedItem="True" BorderThickness="0" SelectionChanged="GridSelectionChanged">
<ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="6,0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Height" Value="{DynamicResource YoakeUiRowHeight}" /><Setter Property="MinHeight" Value="{DynamicResource YoakeUiRowHeight}" /><Setter Property="MaxHeight" Value="{DynamicResource YoakeUiRowHeight}" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style><Style Selector="Grid.subtitle-row"><Setter Property="Background" Value="{DynamicResource SubtitleGridRowBrush}" /></Style><Style Selector="Grid.subtitle-row.comment"><Setter Property="Background" Value="{DynamicResource SubtitleGridCommentBrush}" /></Style><Style Selector="ListBoxItem:selected Grid.subtitle-row"><Setter Property="Background" Value="{DynamicResource SubtitleGridSelectionBrush}" /></Style><Style Selector="ListBoxItem:selected Grid.subtitle-row.comment"><Setter Property="Background" Value="{DynamicResource SubtitleGridCommentSelectionBrush}" /></Style><Style Selector="Grid.subtitle-row TextBlock"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="Foreground" Value="{DynamicResource IconForegroundBrush}" /></Style></ListBox.Styles>
<ListBox.ContextMenu><ContextMenu>
<MenuItem Header="Save selected-line audio clip…" Command="{Binding Actions[audio/save/clip]}" InputGesture="{Binding Actions[audio/save/clip].InputGesture}" />
<MenuItem Name="SelectLinesContextMenu" Header="Select Lines…" InputGesture="{Binding Actions[tool/line/select].InputGesture}" Command="{Binding Actions[tool/line/select]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.SelectLines}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Select visible lines" InputGesture="{Binding Actions[subtitle/select/visible].InputGesture}" Command="{Binding Actions[subtitle/select/visible]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.SelectVisible}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Timing">
<MenuItem Header="Shift Times…" InputGesture="{Binding Actions[time/shift].InputGesture}" Command="{Binding Actions[time/shift]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.ShiftTimes}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Make starts continuous" Command="{Binding Actions[time/continuous/start]}" />
<MenuItem Header="Make ends continuous" Command="{Binding Actions[time/continuous/end]}" />
<MenuItem Header="Snap starts to video" InputGesture="{Binding Actions[time/snap/start_video].InputGesture}" Command="{Binding Actions[time/snap/start_video]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.StartToVideo}" Foreground="{DynamicResource IconTimingStartBrush}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Snap ends to video" InputGesture="{Binding Actions[time/snap/end_video].InputGesture}" Command="{Binding Actions[time/snap/end_video]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.EndToVideo}" Foreground="{DynamicResource IconTimingEndBrush}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Snap to scene" InputGesture="{Binding Actions[time/snap/scene].InputGesture}" Command="{Binding Actions[time/snap/scene]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.SnapScene}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Shift to current frame" InputGesture="{Binding Actions[time/frame/current].InputGesture}" Command="{Binding Actions[time/frame/current]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.ShiftToFrame}" /></MenuItem.Icon></MenuItem>
</MenuItem>
<MenuItem Header="Insert before" InputGesture="{Binding Actions[grid/insert/before].InputGesture}" Command="{Binding Actions[grid/insert/before]}" />
<MenuItem Header="Insert after" InputGesture="{Binding Actions[grid/insert/after].InputGesture}" Command="{Binding Actions[grid/insert/after]}" />
<MenuItem Header="Insert before at video time" Command="{Binding Actions[subtitle/insert/before/videotime]}" InputGesture="{Binding Actions[subtitle/insert/before/videotime].InputGesture}" />
<MenuItem Header="Insert after at video time" Command="{Binding Actions[subtitle/insert/after/videotime]}" InputGesture="{Binding Actions[subtitle/insert/after/videotime].InputGesture}" />
<MenuItem Header="Duplicate" InputGesture="{Binding Actions[grid/duplicate].InputGesture}" Command="{Binding Actions[grid/duplicate]}" />
<MenuItem Header="Delete selected" InputGesture="{Binding Actions[grid/delete].InputGesture}" Command="{Binding Actions[grid/delete]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Delete}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Comment / Uncomment Lines" InputGesture="{Binding Actions[grid/toggle-comment].InputGesture}" Command="{Binding Actions[grid/toggle-comment]}" />
<MenuItem Header="Split at text cursor">
<MenuItem Header="Preserve times" InputGesture="{Binding Actions[edit/line/split/preserve].InputGesture}" Command="{Binding Actions[edit/line/split/preserve]}" />
<MenuItem Header="Estimate times" InputGesture="{Binding Actions[edit/line/split/estimate].InputGesture}" Command="{Binding Actions[edit/line/split/estimate]}" />
<MenuItem Header="At video frame" InputGesture="{Binding Actions[edit/line/split/video].InputGesture}" Command="{Binding Actions[edit/line/split/video]}" />
<MenuItem Header="Divide time equally" InputGesture="{Binding Actions[grid/split].InputGesture}" Command="{Binding Actions[grid/split]}" />
</MenuItem>
<MenuItem Header="Recombine lines" Command="{Binding Actions[edit/line/recombine]}" InputGesture="{Binding Actions[edit/line/recombine].InputGesture}" />
<MenuItem Header="Split by karaoke" InputGesture="{Binding Actions[edit/line/split/by_karaoke].InputGesture}" Command="{Binding Actions[edit/line/split/by_karaoke]}" />
<MenuItem Header="Split before current frame" InputGesture="{Binding Actions[edit/line/split/before].InputGesture}" Command="{Binding Actions[edit/line/split/before]}" />
<MenuItem Header="Split after current frame" InputGesture="{Binding Actions[edit/line/split/after].InputGesture}" Command="{Binding Actions[edit/line/split/after]}" />
<MenuItem Header="Join selected">
<MenuItem Header="Concatenate" InputGesture="{Binding Actions[edit/line/join/concatenate].InputGesture}" Command="{Binding Actions[edit/line/join/concatenate]}" />
<MenuItem Header="Keep first text" InputGesture="{Binding Actions[edit/line/join/keep_first].InputGesture}" Command="{Binding Actions[edit/line/join/keep_first]}" />
<MenuItem Header="As karaoke" InputGesture="{Binding Actions[edit/line/join/as_karaoke].InputGesture}" Command="{Binding Actions[edit/line/join/as_karaoke]}" />
<MenuItem Header="With line breaks" InputGesture="{Binding Actions[grid/join].InputGesture}" Command="{Binding Actions[grid/join]}" />
</MenuItem>
<MenuItem Header="Swap selected lines" InputGesture="{Binding Actions[grid/swap].InputGesture}" Command="{Binding Actions[grid/swap]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.StyleSort}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Sort selected blocks">
<MenuItem Header="By start" InputGesture="{Binding Actions[grid/sort/start/selected].InputGesture}" Command="{Binding Actions[grid/sort/start/selected]}" />
<MenuItem Header="By end" InputGesture="{Binding Actions[grid/sort/end/selected].InputGesture}" Command="{Binding Actions[grid/sort/end/selected]}" />
<MenuItem Header="By style" InputGesture="{Binding Actions[grid/sort/style/selected].InputGesture}" Command="{Binding Actions[grid/sort/style/selected]}" />
<MenuItem Header="By actor" InputGesture="{Binding Actions[grid/sort/actor/selected].InputGesture}" Command="{Binding Actions[grid/sort/actor/selected]}" />
<MenuItem Header="By effect" InputGesture="{Binding Actions[grid/sort/effect/selected].InputGesture}" Command="{Binding Actions[grid/sort/effect/selected]}" />
<MenuItem Header="By layer" InputGesture="{Binding Actions[grid/sort/layer/selected].InputGesture}" Command="{Binding Actions[grid/sort/layer/selected]}" />
<MenuItem Header="By text including tags" Command="{Binding Actions[grid/sort/text/selected]}" InputGesture="{Binding Actions[grid/sort/text/selected].InputGesture}" />
<MenuItem Header="By text without tags" Command="{Binding Actions[grid/sort/text_stripped/selected]}" InputGesture="{Binding Actions[grid/sort/text_stripped/selected].InputGesture}" />
</MenuItem>
<MenuItem Header="Move up" InputGesture="{Binding Actions[grid/move/up].InputGesture}" Command="{Binding Actions[grid/move/up]}" />
<MenuItem Header="Move down" InputGesture="{Binding Actions[grid/move/down].InputGesture}" Command="{Binding Actions[grid/move/down]}" />
<MenuItem Header="Styles Manager…" InputGesture="{Binding Actions[styles/manage].InputGesture}" Command="{Binding Actions[styles/manage]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.StylesManager}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Copy lines" InputGesture="{Binding Actions[grid/copy].InputGesture}" Command="{Binding Actions[grid/copy]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Copy}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Cut lines" InputGesture="{Binding Actions[grid/cut].InputGesture}" Command="{Binding Actions[grid/cut]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Cut}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Paste lines" InputGesture="{Binding Actions[grid/paste].InputGesture}" Command="{Binding Actions[grid/paste]}" ><MenuItem.Icon><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Paste}" /></MenuItem.Icon></MenuItem>
<MenuItem Header="Select all lines" InputGesture="{Binding Actions[grid/select-all].InputGesture}" Command="{Binding Actions[grid/select-all]}" />
</ContextMenu></ListBox.ContextMenu><ListBox.ItemTemplate><DataTemplate x:DataType="sub:AssEvent"><Grid Tag="SubtitleRow" Classes="subtitle-row" Classes.comment="{Binding IsComment}" MinHeight="{DynamicResource YoakeUiRowHeight}" ClipToBounds="True" ColumnDefinitions="32,32,84,84,64,64,64,40,40,40,*">
<Border Grid.ColumnSpan="11" Background="{DynamicResource IconAccentBrush}" Opacity="0.12" IsVisible="{Binding IsActive}" IsHitTestVisible="False" /><Border Grid.ColumnSpan="11" Width="3" HorizontalAlignment="Left" Background="{DynamicResource TabAccentBrush}" IsVisible="{Binding IsCurrent}" IsHitTestVisible="False" /><TextBlock Grid.Column="0" Text="{Binding Number}" FontSize="{DynamicResource YoakeUiFontSizeSmall}" Margin="4,0" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding DisplayLayer}" FontSize="{DynamicResource YoakeUiFontSizeSmall}" Margin="4,0" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding DisplayStart}" FontSize="{DynamicResource YoakeUiFontSizeSmall}" Margin="4,0" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" Text="{Binding DisplayEnd}" FontSize="{DynamicResource YoakeUiFontSizeSmall}" Margin="4,0" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="4" Text="{Binding DisplayStyle}" FontSize="{DynamicResource YoakeUiFontSizeSmall}" Margin="4,0" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="5" Text="{Binding DisplayActor}" FontSize="{DynamicResource YoakeUiFontSizeSmall}" Margin="4,0" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="6" Text="{Binding DisplayEffect}" FontSize="{DynamicResource YoakeUiFontSizeSmall}" Margin="4,0" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="7" Text="{Binding DisplayMarginL}" FontSize="{DynamicResource YoakeUiFontSizeSmall}" Margin="4,0" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="8" Text="{Binding DisplayMarginR}" FontSize="{DynamicResource YoakeUiFontSizeSmall}" Margin="4,0" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="9" Text="{Binding DisplayMarginV}" FontSize="{DynamicResource YoakeUiFontSizeSmall}" Margin="4,0" TextTrimming="CharacterEllipsis" /><controls:SubtitleGridText Grid.Column="10" SourceText="{Binding DisplayText}" Margin="4,0" MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource YoakeUiFontSize}" Foreground="{DynamicResource IconForegroundBrush}" />
</Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
    <Border Name="SubtitleLoadingOverlay" Grid.RowSpan="5" Background="#99000000" IsVisible="{Binding OpeningSubtitle}">
      <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4" Padding="20" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Text="Opening subtitle" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Text="{Binding OpeningSubtitleText}" TextWrapping="Wrap" />
          <ProgressBar IsIndeterminate="True" Height="5" />
          <Button Content="Cancel" HorizontalAlignment="Right" Command="{Binding Actions[subtitle/cancel-open]}" />
        </StackPanel>
      </Border>
    </Border>
  </Grid></Window>
