<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yoake.UI.ViewModels"
        xmlns:icons="using:Yoake.UI.Icons"
        xmlns:controls="using:Yoake.UI.Controls"
        xmlns:sub="using:Yoake.Core.Subtitles"
        x:Class="Yoake.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Yoake"
        Width="1440" Height="900"
        MinWidth="1040" MinHeight="680"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="36,38,*,4,330">
    <Border Grid.Row="0" Name="TitleTabStrip" Background="{DynamicResource TabStripBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <ScrollViewer Grid.Column="0" MaxWidth="980" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DocumentTabViewModel">
                <Border Margin="2,3,0,2" CornerRadius="4" Background="{DynamicResource TabBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="Auto,*,Auto" Width="230" Height="30">
                    <TextBlock Grid.Column="0" Margin="7,0,4,0" VerticalAlignment="Center" Text="●" FontSize="7" IsVisible="{Binding IsActive}" />
                    <Button Grid.Column="1" Padding="4,2" HorizontalContentAlignment="Left" Command="{Binding ActivateCommand}">
                      <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <Button Grid.Column="2" Width="28" Padding="6" Click="CloseTabClick" ToolTip.Tip="Close tab">
                      <PathIcon Width="11" Height="11" Data="{x:Static icons:IconGeometries.Close}" Foreground="{DynamicResource IconForegroundBrush}" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Border Grid.Column="1" WindowDecorationProperties.ElementRole="TitleBar" Background="Transparent" />
        <Button Grid.Column="2" Width="34" Height="30" Margin="3" Command="{Binding NewDocumentCommand}" ToolTip.Tip="New subtitle">
          <PathIcon Width="14" Height="14" Data="{x:Static icons:IconGeometries.New}" Foreground="{DynamicResource IconForegroundBrush}" />
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource CommandBarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="6,3">
        <TextBlock DockPanel.Dock="Right" MaxWidth="520" VerticalAlignment="Center" Opacity="0.72" Text="{Binding SubtitleStatus}" TextTrimming="CharacterEllipsis" Margin="12,0,4,0" />
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Command="{Binding NewDocumentCommand}" ToolTip.Tip="New" Padding="7,3">
            <PathIcon Width="15" Height="15" Data="{x:Static icons:IconGeometries.New}" Foreground="{DynamicResource IconForegroundBrush}" />
          </Button>
          <Button Click="OpenSubtitleClick" Content="Open ASS" Padding="8,3" />
          <Button Click="SaveSubtitleClick" Content="Save" Padding="8,3" />
          <Button Click="OpenMediaClick" Content="Open Video" Padding="8,3" />
          <Border Width="1" Margin="4,2" Background="{DynamicResource DividerBrush}" />
          <Button Command="{Binding UndoCommand}" ToolTip.Tip="Undo" Padding="7,3">
            <PathIcon Width="15" Height="15" Data="{x:Static icons:IconGeometries.Undo}" Foreground="{DynamicResource IconForegroundBrush}" />
          </Button>
          <Button Command="{Binding RedoCommand}" ToolTip.Tip="Redo" Padding="7,3">
            <PathIcon Width="15" Height="15" Data="{x:Static icons:IconGeometries.Redo}" Foreground="{DynamicResource IconForegroundBrush}" />
          </Button>
          <Button Command="{Binding ThemeCycleCommand}" ToolTip.Tip="Cycle theme" Padding="7,3">
            <PathIcon Width="15" Height="15" Data="{x:Static icons:IconGeometries.Theme}" Foreground="{DynamicResource IconForegroundBrush}" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="2*,4,3*" Name="UpperWorkspace">
      <Grid Grid.Column="0" RowDefinitions="*,4,58" Name="VisualColumn">
        <Border Grid.Row="0" Margin="6,6,3,3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
          <Grid RowDefinitions="26,*,34">
            <TextBlock Grid.Row="0" Margin="8,5" FontSize="12" FontWeight="SemiBold" Text="VIDEO" />
            <Border Grid.Row="1" Margin="6,0" Background="#FF000000" ClipToBounds="True">
              <Grid>
                <Image Source="{Binding VideoFrame}" Stretch="Uniform" />
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8" Padding="8,4" CornerRadius="3" Background="#AA111318">
                  <TextBlock Foreground="White" FontSize="11" Text="{Binding MediaStatus}" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                </Border>
              </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="7,3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <Slider Grid.Column="0" Minimum="0" Maximum="{Binding MediaDurationSeconds}" Value="{Binding CurrentTimeSeconds, Mode=TwoWay}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Text="{Binding CurrentTimeSeconds, StringFormat={}{0:0.000}s}" MinWidth="62" />
            </Grid>
          </Grid>
        </Border>
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="{DynamicResource SplitterBrush}" />
        <Border Grid.Row="2" Margin="6,3,3,6" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
          <DockPanel Margin="6">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="VISUAL TOOLS" Margin="0,0,8,0" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Command="{Binding PositionToolCommand}" ToolTip.Tip="Position tool" Padding="6,3">
                <PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Position}" Foreground="{DynamicResource IconForegroundBrush}" />
              </Button>
              <Button Command="{Binding ClipToolCommand}" ToolTip.Tip="Clip tool" Padding="6,3">
                <PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Clip}" Foreground="{DynamicResource IconForegroundBrush}" />
              </Button>
              <TextBlock VerticalAlignment="Center" Margin="5,0,0,0" FontSize="11" Text="{Binding ActiveVisualTool}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SplitterBrush}" />

      <Grid Grid.Column="2" RowDefinitions="150,4,*" Name="TemporalTextColumn">
        <Border Grid.Row="0" Margin="3,6,6,3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
          <Grid RowDefinitions="24,*,22">
            <TextBlock Grid.Row="0" Margin="8,4" FontSize="12" FontWeight="SemiBold" Text="AUDIO" />
            <controls:AudioWaveformControl Grid.Row="1" Margin="6,0" Samples="{Binding WaveformSamples}" Stroke="{DynamicResource IconAccentBrush}" />
            <TextBlock Grid.Row="2" Margin="7,2" FontSize="10" Opacity="0.72" Text="{Binding MediaStatus}" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="{DynamicResource SplitterBrush}" />
        <Border Grid.Row="2" Margin="3,3,6,6" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
          <Grid Margin="7" RowDefinitions="26,32,32,*" IsEnabled="{Binding HasSelectedEvent}">
            <TextBlock Grid.Row="0" FontSize="12" FontWeight="SemiBold" Text="EDIT PANEL" VerticalAlignment="Center" />
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6" Margin="0,0,0,3">
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Text="Start" />
              <TextBox Grid.Column="1" FontSize="11" Padding="5,2" Text="{Binding SelectedEvent.Start, Mode=TwoWay}" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Text="End" />
              <TextBox Grid.Column="3" FontSize="11" Padding="5,2" Text="{Binding SelectedEvent.End, Mode=TwoWay}" />
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6" Margin="0,0,0,3">
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Text="Style" />
              <TextBox Grid.Column="1" FontSize="11" Padding="5,2" Text="{Binding SelectedEvent.Style, Mode=TwoWay}" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Text="Actor" />
              <TextBox Grid.Column="3" FontSize="11" Padding="5,2" Text="{Binding SelectedEvent.Actor, Mode=TwoWay}" />
            </Grid>
            <TextBox Grid.Row="3" FontSize="13" Padding="7" Text="{Binding SelectedEvent.Text, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Watermark="Select a subtitle row to edit its text" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <GridSplitter Grid.Row="3" ResizeDirection="Rows" Background="{DynamicResource SplitterBrush}" />

    <Border Grid.Row="4" Margin="6" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Name="SubtitleGridRegion">
      <Grid RowDefinitions="25,24,*">
        <TextBlock Grid.Row="0" Margin="7,4" FontSize="12" FontWeight="SemiBold" Text="SUBTITLE GRID" />
        <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="6,3">
          <Grid ColumnDefinitions="42,82,82,110,110,*" ColumnSpacing="6">
            <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold" Text="Layer" />
            <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Text="Start" />
            <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Text="End" />
            <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Text="Style" />
            <TextBlock Grid.Column="4" FontSize="11" FontWeight="SemiBold" Text="Actor" />
            <TextBlock Grid.Column="5" FontSize="11" FontWeight="SemiBold" Text="Text" />
          </Grid>
        </Border>
        <ListBox Grid.Row="2" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent, Mode=TwoWay}" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="sub:AssEvent">
              <Grid ColumnDefinitions="42,82,82,110,110,*" ColumnSpacing="6" Margin="3,1">
                <TextBlock Grid.Column="0" FontSize="11" Text="{Binding Layer}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" FontSize="11" Text="{Binding Start}" />
                <TextBlock Grid.Column="2" FontSize="11" Text="{Binding End}" />
                <TextBlock Grid.Column="3" FontSize="11" Text="{Binding Style}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" FontSize="11" Text="{Binding Actor}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="5" FontSize="11" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</Window>
