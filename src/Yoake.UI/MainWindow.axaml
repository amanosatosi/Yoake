<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yoake.UI.ViewModels"
        xmlns:icons="using:Yoake.UI.Icons"
        xmlns:controls="using:Yoake.UI.Controls"
        xmlns:sub="using:Yoake.Core.Subtitles"
        x:Class="Yoake.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Yoake"
        Width="1440" Height="900"
        MinWidth="1040" MinHeight="680"
        FontSize="12"
        Background="{DynamicResource AppBackgroundBrush}">
  <Window.Styles>
    <Style Selector="Button"><Setter Property="MinHeight" Value="24" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="26" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="26" /></Style>
    <Style Selector="CheckBox"><Setter Property="MinHeight" Value="24" /></Style>
  </Window.Styles>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="66" /><RowDefinition Height="3*" MinHeight="398" /><RowDefinition Height="4" /><RowDefinition Height="2*" MinHeight="140" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Name="TitleTabStrip" Background="{DynamicResource TabStripBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <ScrollViewer Name="TabScroll" Grid.Column="0" MaxWidth="980" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DocumentTabViewModel">
                <Border Margin="2,3,0,2" CornerRadius="4" Background="{DynamicResource TabBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="Auto,*,Auto" Width="230" Height="30">
                    <TextBlock Grid.Column="0" Margin="7,0,4,0" VerticalAlignment="Center" Text="●" FontSize="7" IsVisible="{Binding IsActive}" />
                    <Button Grid.Column="1" Padding="4,2" HorizontalContentAlignment="Left" Command="{Binding ActivateCommand}">
                      <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <Button Grid.Column="2" Width="28" Padding="6" Command="{Binding CloseCommand}" ToolTip.Tip="Close tab">
                      <PathIcon Width="11" Height="11" Data="{x:Static icons:IconGeometries.Close}" Foreground="{DynamicResource IconForegroundBrush}" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Border Grid.Column="1" WindowDecorationProperties.ElementRole="TitleBar" Background="Transparent" />
        <Button Grid.Column="2" Width="34" Height="30" Margin="3" Command="{Binding NewDocumentCommand}" ToolTip.Tip="New subtitle">
          <PathIcon Width="14" Height="14" Data="{x:Static icons:IconGeometries.New}" Foreground="{DynamicResource IconForegroundBrush}" />
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource CommandBarBrush}"><Grid RowDefinitions="28,*"><Menu>
<MenuItem Header="File">
<MenuItem Header="Recent files" ItemsSource="{Binding RecentFiles}"><MenuItem.ItemTemplate><DataTemplate x:DataType="x:String"><Button Content="{Binding}" Click="RecentFileClick" /></DataTemplate></MenuItem.ItemTemplate></MenuItem>
<MenuItem Header="New" Command="{Binding Actions[subtitle/new]}" />
<MenuItem Header="Open…" Command="{Binding Actions[subtitle/open]}" />
<MenuItem Header="Save" Command="{Binding Actions[subtitle/save]}" />
<MenuItem Header="Save As…" Command="{Binding Actions[subtitle/save-as]}" />
<MenuItem Header="Reload from disk…" Command="{Binding Actions[subtitle/revert]}" />
<MenuItem Header="Close tab" Command="{Binding Actions[subtitle/close]}" />
</MenuItem>
<MenuItem Header="Edit">
<MenuItem Header="Undo" Command="{Binding Actions[edit/undo]}" />
<MenuItem Header="Redo" Command="{Binding Actions[edit/redo]}" />
<MenuItem Header="Copy lines" Command="{Binding Actions[grid/copy]}" />
<MenuItem Header="Cut lines" Command="{Binding Actions[grid/cut]}" />
<MenuItem Header="Paste lines" Command="{Binding Actions[grid/paste]}" />
<MenuItem Header="Select all lines" Command="{Binding Actions[grid/select-all]}" />
<MenuItem Header="Find / Replace…" Command="{Binding Actions[edit/find]}" />
</MenuItem>
<MenuItem Header="Subtitle">
<MenuItem Header="Insert before" Command="{Binding Actions[grid/insert/before]}" />
<MenuItem Header="Insert after" Command="{Binding Actions[grid/insert/after]}" />
<MenuItem Header="Duplicate" Command="{Binding Actions[grid/duplicate]}" />
<MenuItem Header="Delete selected" Command="{Binding Actions[grid/delete]}" />
<MenuItem Header="Dialogue / Comment" Command="{Binding Actions[grid/toggle-comment]}" />
<MenuItem Header="Split at text cursor" Command="{Binding Actions[grid/split]}" />
<MenuItem Header="Join selected" Command="{Binding Actions[grid/join]}" />
<MenuItem Header="Move up" Command="{Binding Actions[grid/move/up]}" />
<MenuItem Header="Move down" Command="{Binding Actions[grid/move/down]}" />
<MenuItem Header="Styles Manager…" Command="{Binding Actions[styles/manage]}" />
<MenuItem Header="Script Info…" Command="{Binding Actions[script-info/edit]}" />
</MenuItem>
<MenuItem Header="Timing">
<MenuItem Header="Set start to current time" Command="{Binding Actions[timing/set-start]}" />
<MenuItem Header="Set end to current time" Command="{Binding Actions[timing/set-end]}" />
<MenuItem Header="Jump to line start" Command="{Binding Actions[timing/jump-start]}" />
<MenuItem Header="Jump to line end" Command="{Binding Actions[timing/jump-end]}" />
<MenuItem Header="Previous subtitle" Command="{Binding Actions[grid/line/previous]}" />
<MenuItem Header="Next subtitle" Command="{Binding Actions[grid/line/next]}" />
</MenuItem>
<MenuItem Header="Video">
<MenuItem Header="Open video/audio…" Command="{Binding Actions[media/open]}" />
<MenuItem Header="Play / Pause" Command="{Binding Actions[video/play]}" />
<MenuItem Header="Stop" Command="{Binding Actions[video/stop]}" />
<MenuItem Header="Previous frame" Command="{Binding Actions[video/frame/previous]}" />
<MenuItem Header="Next frame" Command="{Binding Actions[video/frame/next]}" />
<MenuItem Header="Position tool" Command="{Binding Actions[video/tool/position]}" />
<MenuItem Header="Clip tool" Command="{Binding Actions[video/tool/clip]}" />
</MenuItem>
<MenuItem Header="Audio">
<MenuItem Header="Play current line" Command="{Binding Actions[audio/play/selection]}" />
<MenuItem Header="Play from cursor" Command="{Binding Actions[audio/play/cursor]}" />
<MenuItem Header="Zoom in" Command="{Binding Actions[audio/zoom/in]}" />
<MenuItem Header="Zoom out" Command="{Binding Actions[audio/zoom/out]}" />
</MenuItem>
<MenuItem Header="View">
<MenuItem Header="Cycle theme" Command="{Binding Actions[view/theme/cycle]}" />
</MenuItem>
</Menu><DockPanel Grid.Row="1" Margin="6,2"><TextBlock DockPanel.Dock="Right" MaxWidth="580" Text="{Binding SubtitleStatus}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" Spacing="4">
<Button Content="New" Command="{Binding NewDocumentCommand}" Padding="6,1" ToolTip.Tip="Ctrl+N" /><Button Content="Open ASS" Command="{Binding Actions[subtitle/open]}" Padding="6,1" ToolTip.Tip="Ctrl+O" /><Button Content="Save" Command="{Binding Actions[subtitle/save]}" Padding="6,1" ToolTip.Tip="Ctrl+S" /><Button Content="Open media" Command="{Binding Actions[media/open]}" Padding="6,1" />
<Button Command="{Binding UndoCommand}" Padding="6,1" ToolTip.Tip="Undo (Ctrl+Z)"><PathIcon Width="15" Height="15" Data="{x:Static icons:IconGeometries.Undo}" /></Button><Button Command="{Binding RedoCommand}" Padding="6,1" ToolTip.Tip="Redo (Ctrl+Y)"><PathIcon Width="15" Height="15" Data="{x:Static icons:IconGeometries.Redo}" /></Button>
</StackPanel></DockPanel></Grid></Border>
<Grid Grid.Row="2" Name="UpperWorkspace">
  <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="340" /><ColumnDefinition Width="4" /><ColumnDefinition Width="3*" MinWidth="480" /></Grid.ColumnDefinitions>
  <Grid Grid.Column="0" RowDefinitions="*,Auto" Name="VisualColumn">
    <Border Grid.Row="0" Margin="6,6,3,3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
      <Grid Name="VideoRegion" RowDefinitions="24,*,26,28,18">
        <TextBlock Text="VIDEO" FontWeight="SemiBold" Margin="7,3" />
        <Border Grid.Row="1" Margin="5,0" Background="Black" ClipToBounds="True"><Grid><Image Name="VideoImage" Source="{Binding VideoFrame}" Stretch="Uniform" /><controls:VisualOverlayControl Name="VisualOverlay" Model="{Binding}" /></Grid></Border>
        <controls:VideoFrameSlider Name="VideoSeekBar" Grid.Row="2" Margin="5,0" Model="{Binding}" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4" Margin="5,0">
          <Button Content="{Binding PlayPauseText}" Command="{Binding Actions[video/play]}" Padding="5,1" /><Button Content="Stop" Command="{Binding Actions[video/stop]}" Padding="5,1" />
          <Button Content="◀" Command="{Binding Actions[video/frame/previous]}" Padding="4,0" ToolTip.Tip="Previous decoded frame" /><Button Content="▶" Command="{Binding Actions[video/frame/next]}" Padding="4,0" ToolTip.Tip="Next decoded frame" />
          <TextBox Name="ExactTime" Width="92" Padding="4,0" PlaceholderText="h:mm:ss.cc" /><Button Content="Seek" Command="{Binding Actions[video/seek]}" CommandParameter="{Binding #ExactTime.Text}" Padding="4,0" />
        </StackPanel>
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="5,0"><TextBlock Text="{Binding FramePositionDisplay}" FontSize="10" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding RelativeTimingDisplay}" FontSize="10" ToolTip.Tip="Frame time relative to subtitle start; end" /></Grid>
      </Grid>
    </Border>
    <Border Grid.Row="1" Name="VisualToolsBar" Margin="6,0,3,3" Background="{DynamicResource PanelBrush}"><StackPanel Orientation="Horizontal" Spacing="4" Margin="6,2">
      <TextBlock Text="VISUAL TOOLS" FontSize="11" VerticalAlignment="Center" />
      <ToggleButton Classes="authoring" IsChecked="{Binding IsPositionTool, Mode=OneWay}" Command="{Binding PositionToolCommand}" Padding="5,1" ToolTip.Tip="Position: drag on video"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Position}" /></ToggleButton>
      <ToggleButton Classes="authoring" IsChecked="{Binding IsClipTool, Mode=OneWay}" Command="{Binding ClipToolCommand}" Padding="5,1" ToolTip.Tip="Clip: drag to create rectangle; drag handles to edit; Shift+drag moves clip"><PathIcon Width="16" Height="16" Data="{x:Static icons:IconGeometries.Clip}" /></ToggleButton>
      <CheckBox Content="New clip inverse" IsChecked="{Binding InverseClip, Mode=TwoWay}" FontSize="11" />
    </StackPanel></Border>
  </Grid>
  <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource SplitterBrush}" />
  <Grid Grid.Column="2" Name="TemporalTextColumn">
    <Grid.RowDefinitions><RowDefinition Height="130" MinHeight="72" /><RowDefinition Height="4" /><RowDefinition Height="*" MinHeight="264" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Margin="3,6,6,3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
      <Grid Name="AudioRegion" RowDefinitions="26,*,16,16">
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,1"><TextBlock Text="AUDIO" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="−" Command="{Binding Actions[audio/zoom/out]}" Padding="5,0" /><Button Content="+" Command="{Binding Actions[audio/zoom/in]}" Padding="5,0" /><Button Content="Play line" Command="{Binding Actions[audio/play/selection]}" Padding="5,0" /><ToggleButton Classes="authoring" Content="Mute" IsChecked="{Binding PlaybackMuted, Mode=TwoWay}" Padding="4,0" ToolTip.Tip="Mute editor playback" /><Button Content="▶/Ⅱ" Command="{Binding Actions[video/play]}" Padding="4,0" ToolTip.Tip="Play / pause from cursor" /><ComboBox Name="AudioMode" SelectedIndex="0" SelectionChanged="AudioModeChanged" Padding="5,0"><ComboBoxItem Content="Waveform" /><ComboBoxItem Content="Spectrogram" /></ComboBox></StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,24,24,24" ColumnSpacing="2" Margin="5,0">
          <controls:AudioWaveformControl Name="AudioDisplay" ToolTip.Tip="Click: seek · Green/red: drag start/end · Shift+drag inside line: move timing · Wheel: pan · Ctrl+wheel: zoom" Model="{Binding}" Samples="{Binding WaveformSamples}" Stroke="{DynamicResource IconAccentBrush}" />
          <Slider Grid.Column="1" Name="AudioSize" Orientation="Vertical" Minimum="100" Maximum="400" Value="{Binding AudioDisplayHeight, Mode=TwoWay}" ToolTip.Tip="Visualizer height (DIP)" />
          <Slider Grid.Column="2" Name="AudioIntensity" Orientation="Vertical" Minimum="0.1" Maximum="8" Value="{Binding AudioIntensity, Mode=TwoWay}" ToolTip.Tip="Display amplitude / spectral intensity (independent of volume)" />
          <Slider Grid.Column="3" Name="AudioVolume" Orientation="Vertical" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding PlaybackVolume, Mode=TwoWay}" ToolTip.Tip="Playback volume · 0–100%" />
        </Grid>
        <ScrollBar Grid.Row="2" Name="AudioPanner" Orientation="Horizontal" Minimum="0" Maximum="{Binding #AudioDisplay.MaximumPan}" ViewportSize="{Binding #AudioDisplay.VisibleSeconds}" Value="{Binding #AudioDisplay.ViewportStart, Mode=TwoWay}" SmallChange="0.5" LargeChange="5" Margin="5,0,80,0" ToolTip.Tip="Pan the visible audio time range" />
        <TextBlock Grid.Row="3" Text="{Binding MediaStatus}" TextTrimming="CharacterEllipsis" FontSize="10" Margin="6,0" />
      </Grid>
    </Border>
    <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="{DynamicResource SplitterBrush}" />
    <Border Grid.Row="2" Margin="3,3,6,6" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
      <Grid Name="EventEditorRegion" Margin="5" RowDefinitions="26,Auto,Auto,Auto,14,*" RowSpacing="2" IsEnabled="{Binding HasSelectedEvent}">
        <Grid.Styles>
          <Style Selector="TextBox"><Setter Property="MinHeight" Value="24" /><Setter Property="FontSize" Value="12" /></Style>
          <Style Selector="ComboBox"><Setter Property="MinHeight" Value="24" /><Setter Property="FontSize" Value="12" /></Style>
          <Style Selector="NumericUpDown"><Setter Property="MinHeight" Value="24" /><Setter Property="FontSize" Value="12" /></Style>
          <Style Selector="Button"><Setter Property="MinHeight" Value="24" /></Style>
        </Grid.Styles>
        <DockPanel><TextBlock Text="EDIT PANEL" FontSize="11" FontWeight="SemiBold" /><Button Content="Finish · Ctrl+Enter" Command="{Binding Actions[edit/commit]}" Padding="4,0" HorizontalAlignment="Right" FontSize="11" /></DockPanel>
        <Grid Grid.Row="1" ColumnDefinitions="80,1.2*,26,*,*,86" ColumnSpacing="3">
          <CheckBox Height="26" VerticalAlignment="Center" Content="Comment" IsChecked="{Binding SelectedIsComment, Mode=OneWay}" Command="{Binding Actions[edit/comment]}" CommandParameter="{Binding $self.IsChecked}" FontSize="11" />
          <ComboBox Height="26" VerticalAlignment="Center" Grid.Column="1" ItemsSource="{Binding StyleNames}" SelectedItem="{Binding EditorDraft.Style, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="3,0" ToolTip.Tip="Style" />
          <Button Height="26" VerticalAlignment="Center" Grid.Column="2" Content="…" Command="{Binding Actions[styles/manage]}" Padding="3,0" ToolTip.Tip="Edit selected style in Styles Manager" />
          <AutoCompleteBox Height="26" VerticalAlignment="Center" Grid.Column="3" ItemsSource="{Binding ActorNames}" Text="{Binding EditorDraft.Actor, Mode=TwoWay}" MinimumPrefixLength="1" Padding="3,0" PlaceholderText="Actor" ToolTip.Tip="Actor / Name" />
          <TextBox Height="26" VerticalAlignment="Center" Grid.Column="4" Text="{Binding EditorDraft.Effect, Mode=TwoWay}" Padding="3,0" PlaceholderText="Effect" />
          <NumericUpDown Name="LineLayer" Grid.Column="5" Value="{Binding EditorDraft.LayerNumber, Mode=TwoWay}" Minimum="-2147483648" Maximum="2147483647" Increment="1" FormatString="0" Padding="2,0" ToolTip.Tip="Layer" />
        </Grid>
        <WrapPanel Grid.Row="2" Name="TimingFields">
          <Grid ColumnDefinitions="Auto,96,Auto,96,Auto,72" ColumnSpacing="3" Margin="0,0,8,2">
            <TextBlock Text="Start" FontSize="10" VerticalAlignment="Center" /><TextBox Name="LineStart" Grid.Column="1" Text="{Binding EditorDraft.Start, Mode=TwoWay}" Padding="3,0" ToolTip.Tip="Start h:mm:ss.cc" />
            <TextBlock Grid.Column="2" Text="End" FontSize="10" VerticalAlignment="Center" /><TextBox Name="LineEnd" Grid.Column="3" Text="{Binding EditorDraft.End, Mode=TwoWay}" Padding="3,0" ToolTip.Tip="End h:mm:ss.cc" />
            <TextBlock Grid.Column="4" Text="Dur." FontSize="10" VerticalAlignment="Center" /><TextBlock Grid.Column="5" Text="{Binding EditorDraft.Duration}" FontSize="11" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="Auto,86,Auto,86,Auto,86" ColumnSpacing="3" Margin="0,0,0,2">
            <TextBlock Text="L" FontSize="10" VerticalAlignment="Center" /><NumericUpDown Name="MarginLeft" Grid.Column="1" Value="{Binding EditorDraft.LeftMargin, Mode=TwoWay}" Minimum="0" Maximum="2147483647" Increment="1" FormatString="0" ToolTip.Tip="Left margin (script pixels)" />
            <TextBlock Grid.Column="2" Text="R" FontSize="10" VerticalAlignment="Center" /><NumericUpDown Name="MarginRight" Grid.Column="3" Value="{Binding EditorDraft.RightMargin, Mode=TwoWay}" Minimum="0" Maximum="2147483647" Increment="1" FormatString="0" ToolTip.Tip="Right margin (script pixels)" />
            <TextBlock Grid.Column="4" Text="V" FontSize="10" VerticalAlignment="Center" /><NumericUpDown Name="MarginVertical" Grid.Column="5" Value="{Binding EditorDraft.VerticalMargin, Mode=TwoWay}" Minimum="0" Maximum="2147483647" Increment="1" FormatString="0" ToolTip.Tip="Vertical margin (script pixels)" />
          </Grid>
        </WrapPanel>
        <WrapPanel Grid.Row="3" Name="FormattingToolbar">
          <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,6,2">
            <ToggleButton Classes="authoring" Content="B" FontWeight="Bold" IsThreeState="True" IsChecked="{Binding Formatting.Bold, Mode=OneWay}" Command="{Binding Actions[text/format/bold]}" ToolTip.Tip="Bold · Ctrl+B (mixed/animated state is indeterminate)" />
            <ToggleButton Classes="authoring" Content="I" FontStyle="Italic" IsThreeState="True" IsChecked="{Binding Formatting.Italic, Mode=OneWay}" Command="{Binding Actions[text/format/italic]}" ToolTip.Tip="Italic · Ctrl+I" />
            <ToggleButton Classes="authoring" IsThreeState="True" IsChecked="{Binding Formatting.Underline, Mode=OneWay}" Command="{Binding Actions[text/format/underline]}" ToolTip.Tip="Underline · Ctrl+U"><TextBlock Text="U" TextDecorations="Underline" /></ToggleButton>
            <ToggleButton Classes="authoring" IsThreeState="True" IsChecked="{Binding Formatting.Strikeout, Mode=OneWay}" Command="{Binding Actions[text/format/strikeout]}" ToolTip.Tip="Strikeout"><TextBlock Text="S" TextDecorations="Strikethrough" /></ToggleButton>
            <Button Content="Font…" Command="{Binding Actions[text/format/font]}" Padding="5,0" ToolTip.Tip="Font family and size for selection" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,6,2">
            <controls:AssColorButton Value="{Binding Formatting.Primary}" Label="1" Command="{Binding Actions[text/format/primary]}" ToolTip.Tip="Primary color and alpha at caret (static state)" />
            <controls:AssColorButton Value="{Binding Formatting.Secondary}" Label="2" Command="{Binding Actions[text/format/secondary]}" ToolTip.Tip="Secondary karaoke color and alpha at caret (static state)" />
            <controls:AssColorButton Value="{Binding Formatting.Outline}" Label="3" Command="{Binding Actions[text/format/outline]}" ToolTip.Tip="Outline color and alpha at caret (static state)" />
            <controls:AssColorButton Value="{Binding Formatting.Shadow}" Label="4" Command="{Binding Actions[text/format/shadow]}" ToolTip.Tip="Shadow color and alpha at caret (static state)" />
            <Button Content="Reset" Command="{Binding Actions[text/format/reset]}" Padding="5,0" FontSize="11" ToolTip.Tip="Reset to line style at caret / selection" />
          </StackPanel>
        </WrapPanel>
        <TextBlock Grid.Row="4" Text="Enter: finish and next · Shift+Enter: newline · Ctrl+Shift+D: split" FontSize="10" VerticalAlignment="Center" />
        <controls:AssTextBox Name="SubtitleText" Grid.Row="5" FontSize="14" Text="{Binding EditorDraft.Text, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MinHeight="64" />
      </Grid>
    </Border>
  </Grid>
</Grid>
<GridSplitter Grid.Row="3" ResizeDirection="Rows" Background="{DynamicResource SplitterBrush}" />
<Border Grid.Row="4" Margin="6" Name="SubtitleGridRegion" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
<Grid RowDefinitions="24,*" ToolTip.Tip="SUBTITLE GRID">
<Border Padding="10,2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"><Grid Name="ColumnHeader" PointerPressed="HeaderPressed" PointerMoved="HeaderMoved" PointerReleased="HeaderReleased" ColumnDefinitions="40,36,92,92,110,100,90,*" ColumnSpacing="4" ToolTip.Tip="Drag a column boundary to resize"><TextBlock Text="#" /><TextBlock Grid.Column="1" Text="L" ToolTip.Tip="Layer" /><TextBlock Grid.Column="2" Text="Start" /><TextBlock Grid.Column="3" Text="End" /><TextBlock Grid.Column="4" Text="Style" /><TextBlock Grid.Column="5" Text="Actor" /><TextBlock Grid.Column="6" Text="Effect" /><TextBlock Grid.Column="7" Text="Text" /></Grid></Border>
<ListBox Name="SubtitleRows" Grid.Row="1" ItemsSource="{Binding Events}" SelectionMode="Multiple" AutoScrollToSelectedItem="True" BorderThickness="0" SelectionChanged="GridSelectionChanged">
<ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="6,0" /><Setter Property="Height" Value="30" /><Setter Property="MinHeight" Value="30" /><Setter Property="MaxHeight" Value="30" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style><Style Selector="Grid.subtitle-row TextBlock"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextWrapping" Value="NoWrap" /></Style><Style Selector="Grid.subtitle-row.comment TextBlock"><Setter Property="Foreground" Value="{DynamicResource AssSyntaxUnknown}" /></Style><Style Selector="ListBoxItem:selected Grid.subtitle-row TextBlock"><Setter Property="Foreground" Value="{DynamicResource IconForegroundBrush}" /></Style></ListBox.Styles>
<ListBox.ContextMenu><ContextMenu>
<MenuItem Header="Insert before" Command="{Binding Actions[grid/insert/before]}" />
<MenuItem Header="Insert after" Command="{Binding Actions[grid/insert/after]}" />
<MenuItem Header="Duplicate" Command="{Binding Actions[grid/duplicate]}" />
<MenuItem Header="Delete selected" Command="{Binding Actions[grid/delete]}" />
<MenuItem Header="Dialogue / Comment" Command="{Binding Actions[grid/toggle-comment]}" />
<MenuItem Header="Split at text cursor" Command="{Binding Actions[grid/split]}" />
<MenuItem Header="Join selected" Command="{Binding Actions[grid/join]}" />
<MenuItem Header="Move up" Command="{Binding Actions[grid/move/up]}" />
<MenuItem Header="Move down" Command="{Binding Actions[grid/move/down]}" />
<MenuItem Header="Styles Manager…" Command="{Binding Actions[styles/manage]}" />
<MenuItem Header="Copy lines" Command="{Binding Actions[grid/copy]}" />
<MenuItem Header="Cut lines" Command="{Binding Actions[grid/cut]}" />
<MenuItem Header="Paste lines" Command="{Binding Actions[grid/paste]}" />
<MenuItem Header="Select all lines" Command="{Binding Actions[grid/select-all]}" />
</ContextMenu></ListBox.ContextMenu><ListBox.ItemTemplate><DataTemplate x:DataType="sub:AssEvent"><Grid Tag="SubtitleRow" Classes="subtitle-row" Classes.comment="{Binding IsComment}" Height="30" ClipToBounds="True" ColumnDefinitions="40,36,92,92,110,100,90,*" ColumnSpacing="4">
<Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource IconAccentBrush}" IsVisible="{Binding IsCurrent}" /><Border Grid.ColumnSpan="8" Background="{DynamicResource IconAccentBrush}" Opacity="0.12" IsVisible="{Binding IsActive}" /><TextBlock Text="{Binding Number}" FontSize="11" Margin="5,0,0,0" /><TextBlock Grid.Column="1" Text="{Binding DisplayLayer}" FontSize="11" /><TextBlock Grid.Column="2" Text="{Binding DisplayStart}" FontSize="11" /><TextBlock Grid.Column="3" Text="{Binding DisplayEnd}" FontSize="11" /><TextBlock Grid.Column="4" Text="{Binding DisplayStyle}" TextTrimming="CharacterEllipsis" FontSize="11" /><TextBlock Grid.Column="5" Text="{Binding DisplayActor}" TextTrimming="CharacterEllipsis" FontSize="11" /><TextBlock Grid.Column="6" Text="{Binding DisplayEffect}" TextTrimming="CharacterEllipsis" FontSize="11" /><TextBlock Grid.Column="7" Text="{Binding DisplayText}" MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="12" />
</Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border></Grid></Window>
