<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yoake.UI.ViewModels" x:Class="Yoake.UI.AudioTimingOptionsWindow" x:DataType="vm:MainWindowViewModel"
        Title="Audio timing preferences" Width="380" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="14" Spacing="10">
    <CheckBox Content="Auto-commit timing" IsChecked="{Binding AudioAutoCommit, Mode=OneWay}" Command="{Binding Actions[audio/opt/autocommit]}" />
    <CheckBox Content="Next line on commit" IsChecked="{Binding AudioAutoNext, Mode=OneWay}" Command="{Binding Actions[audio/opt/autonext]}" />
    <Grid ColumnDefinitions="*,100" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
      <TextBlock Text="Default duration (ms)" VerticalAlignment="Center" />
      <NumericUpDown Grid.Column="1" Name="DefaultDuration" Minimum="10" Maximum="600000" Increment="10" FormatString="0" Value="{Binding AudioTimingDefaultDuration, Mode=TwoWay}" />
      <TextBlock Grid.Row="1" Text="Lead-in (ms)" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="1" Grid.Column="1" Name="LeadIn" Minimum="0" Maximum="60000" Increment="10" FormatString="0" Value="{Binding AudioTimingLeadIn, Mode=TwoWay}" />
      <TextBlock Grid.Row="2" Text="Lead-out (ms)" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="2" Grid.Column="1" Name="LeadOut" Minimum="0" Maximum="60000" Increment="10" FormatString="0" Value="{Binding AudioTimingLeadOut, Mode=TwoWay}" />
    </Grid>
    <TextBlock Text="Applies to the audio timing workflow. Generic line insertion keeps its existing two-second policy." TextWrapping="Wrap" FontSize="11" />
    <Button Name="CloseOptions" Content="Close" HorizontalAlignment="Right" />
  </StackPanel>
</Window>
